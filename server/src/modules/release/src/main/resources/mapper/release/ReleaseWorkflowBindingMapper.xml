  <sql id="columns">id,tenant_id,project_ref,project_name,scene_code,workflow_definition_id,workflow_code,workflow_name,workflow_version,row_version,created_by,updated_by,created_at,updated_at</sql>
  <select id="findProject" resultMap="binding">SELECT <include refid="columns"/> FROM rel_workflow_binding WHERE tenant_id=#{tenantId} AND project_ref=#{projectRef} ORDER BY scene_code</select>
  <select id="find" resultMap="binding">SELECT <include refid="columns"/> FROM rel_workflow_binding WHERE tenant_id=#{tenantId} AND project_ref=#{projectRef} AND scene_code=#{scene}</select>
  <select id="findForUpdate" resultMap="binding">SELECT <include refid="columns"/> FROM rel_workflow_binding WHERE tenant_id=#{tenantId} AND project_ref=#{projectRef} AND scene_code=#{scene} FOR UPDATE</select>
  <insert id="insert">INSERT INTO rel_workflow_binding (id,tenant_id,project_ref,project_name,scene_code,workflow_definition_id,workflow_code,workflow_name,workflow_version,row_version,created_by,updated_by) VALUES (#{id},#{tenantId},#{projectRef},#{projectName},#{scene},#{workflowDefinitionId},#{workflowCode},#{workflowName},#{workflowVersion},#{rowVersion},#{createdBy},#{updatedBy})</insert>
