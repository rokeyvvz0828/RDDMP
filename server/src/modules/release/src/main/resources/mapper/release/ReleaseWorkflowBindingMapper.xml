  <resultMap id="binding" type="com.ccb.release.workflow.model.ReleaseWorkflowBindingModels$Binding"><constructor><idArg column="id" javaType="long"/><arg column="tenant_id" javaType="long"/><arg column="project_ref"/><arg column="project_name"/><arg column="scene_code" javaType="com.ccb.release.workflow.model.ReleaseWorkflowBindingModels$Scene"/><arg column="workflow_definition_id" javaType="java.lang.Long"/><arg column="workflow_code"/><arg column="workflow_name"/><arg column="workflow_version" javaType="java.lang.Integer"/><arg column="row_version" javaType="long"/><arg column="created_by" javaType="long"/><arg column="updated_by" javaType="long"/><arg column="created_at" javaType="java.time.LocalDateTime"/><arg column="updated_at" javaType="java.time.LocalDateTime"/></constructor></resultMap>
