    {"id":"R1","statement":"Secure login and session maintenance","acceptance":["valid credentials return access and refresh tokens","invalid and disabled accounts fail","expired access token refreshes"],"priority":"must","source":"user-approved design","counterexample":["frontend-only security"]},
    {"id":"R2","statement":"Single-tenant organization and account model","acceptance":["organization tree users and roles are manageable","users link to organization and roles"],"priority":"must","source":"user-approved design","counterexample":["flat organization list"]},
    {"id":"R3","statement":"Roles constrain menus buttons and APIs","acceptance":["authorized menus appear","unauthorized APIs return 403","button permission is queryable"],"priority":"must","source":"user-approved design","counterexample":["frontend guards only"]},
    {"id":"R4","statement":"Menus support dynamic routes","acceptance":["route and permission fields persist","login builds Vue Router routes"],"priority":"must","source":"user-approved design","counterexample":["hardcoded routes"]},
    {"id":"R5","statement":"Dictionary and system configuration management","acceptance":["types items and configs are manageable","values query by code"],"priority":"must","source":"user-approved design","counterexample":["source configuration"]},
