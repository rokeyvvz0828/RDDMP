    "objective": "完成流程定义生命周期、BPMN 语义节点、连线条件编辑、上下文菜单、只读流程查看和 Dagre 自动布局。",
    "requirements": [
      {"id":"R1","statement":"草稿流程可删除，已发布流程可只读查看且不可删除或原地修改。","priority":"must"},
      {"id":"R2","statement":"开始、结束、审批、网关和抄送节点使用可辨识的 BPMN 语义外观。","priority":"must"},
      {"id":"R3","statement":"节点和连线提供上下文操作，连线具有方向并可编辑名称、条件和默认分支。","priority":"must"},
      {"id":"R4","statement":"使用 Dagre 进行横向/纵向分层布局，避免节点遮挡并保留手工位置。","priority":"must"}
    ],
    "invariants": [
      "所有后端定义查询带 tenant_id 和 deleted = 0 条件",
      "已发布流程不可删除和原地修改",
      "边的 label、condition、default 字段端到端保持",
      "只读画布不触发写操作",
      "界面和错误提示使用中文"
    ],
    "constraints": [
      "Spring Boot 3、JDK 17、MySQL、Flowable、Vue 3、TypeScript、Element Plus、Vue Flow",
      "不直接操作 Flowable ACT_* 表",
      "不实现服务任务和消息事件运行语义"
    ],
    "non_goals": ["BPMN 全量规范", "新的工作流运行引擎", "跨租户流程共享"]
  },
