    "human_document": "docs/engineering-control/designs/2026-08-31-release-project-scope-design.md",
    "objective": "配置管理六个菜单严格依据顶部当前项目展示和操作，并由服务端阻止跨项目读取与写入。",
    "users": ["项目成员", "版本申请审核人", "超级管理员"],
    "requirements": [
      {"id": "R1", "statement": "六个配置管理菜单的列表请求必须使用顶部当前项目，缺少项目范围时服务端拒绝租户全量查询。", "acceptance": ["切换项目后仅展示新项目数据", "缺少项目编码返回 400", "旧响应不能覆盖新项目"], "priority": "must", "source": "用户项目维度要求", "counterexample": ["返回租户全量", "显示旧项目数据"]},
      {"id": "R2", "statement": "服务端必须统一校验当前用户对目标项目的访问权限。", "acceptance": ["有效成员和超级管理员可访问未删除项目", "非成员或停用成员返回 403", "不存在或删除项目被拒绝"], "priority": "must", "source": "用户确认统一服务方案", "counterexample": ["仅前端校验"]},
      {"id": "R3", "statement": "详情和写操作必须从服务端实体反查所属项目并拒绝跨项目参数伪造。", "acceptance": ["无权实体返回 403", "跨项目关联不产生写入"], "priority": "must", "source": "工程安全边界", "counterexample": ["信任请求体 projectId"]},
      {"id": "R4", "statement": "版本申请直接链接对有权项目自动切换顶部项目，对无权项目拒绝访问。", "acceptance": ["有权时切换并加载", "无权时停止后续请求"], "priority": "must", "source": "用户明确确认", "counterexample": ["顶部项目与详情不一致"]},
      {"id": "R5", "statement": "现有菜单 RBAC、审批流程、业务状态机和数据库模型必须保持兼容。", "acceptance": ["权限和状态回归通过", "无迁移"], "priority": "must", "source": "确认范围", "counterexample": ["顺带修改权限或流程"]}
    ],
    "invariants": ["身份来自 AuthUser", "实体项目来自服务端", "后端最终授权", "不覆盖未关联改动"],
    "constraints": ["Java 17 与 Vue 3 现有模式", "公共能力回归", "无迁移", "桌面与 H5 验收"],
    "non_goals": ["全局项目请求头", "项目化 URL", "其他业务模块", "权限种子调整"],
    "selected_approach": {
      "name": "显式项目参数与后端统一访问服务",
      "reason": "兼容现有 API 并覆盖列表、实体和直接链接。",
      "alternatives": [
        {"name": "全局项目请求头", "rejected_because": "内部事件边界复杂且不能替代实体反查。"},
        {"name": "项目化 URL", "rejected_because": "兼容成本超出范围。"}
      ]
    },
    "architecture": {
      "boundary": {"inside": ["platform/system 项目访问", "business/release", "release 前端"], "outside": ["工作流内部", "数据库", "其他业务模块"]},
      "components": [
      {"name": "ProjectAccessService", "responsibility": "公开项目访问契约", "depends_on": ["AuthUser"]},
      {"name": "JdbcProjectAccessService", "responsibility": "internal 项目解析和成员访问校验实现", "depends_on": ["JdbcTemplate", "ProjectAccessService"]},
        {"name": "Release services", "responsibility": "列表和实体项目门禁", "depends_on": ["ProjectAccessService", "stores"]},
        {"name": "Release frontend", "responsibility": "当前项目传递、直接链接同步和竞态保护", "depends_on": ["project store", "release API"]}
      ],
      "interfaces": [
        {"name": "requireAccessible", "producer": "platform/system", "consumers": ["business/release"], "contract": "输入 projectRef/AuthUser，返回规范项目或拒绝"},
        {"name": "release projectRef", "producer": "release controllers", "consumers": ["release API"], "contract": "列表和统计项目编码必填"}
      ],
      "data_flows": [
        {"input": "顶部 projectRef", "transitions": ["访问校验", "项目过滤查询"], "output": "当前项目数据"},
        {"input": "实体 ID", "transitions": ["实体读取", "项目反查", "访问校验"], "output": "授权操作或拒绝"}
      ]
    },
    "error_handling": [
      {"condition": "缺少项目", "behavior": "400 并清空旧数据", "recovery": "选择项目重试"},
      {"condition": "非成员", "behavior": "403 和无权提示", "recovery": "配置成员关系"},
      {"condition": "旧响应晚到", "behavior": "丢弃响应", "recovery": "无需操作"}
    ],
    "quality_attributes": {
      "security": ["租户、成员、实体归属校验"],
      "performance": ["每请求至多一次项目访问查询"],
      "compatibility": ["保留 RBAC、流程和数据模型"],
      "operations": ["区分 400 与 403"]
    },
    "verification_strategy": [
      {"requirement_ids": ["R1", "R4"], "signal": "切换和链接不串项目", "method": "构建与浏览器旅程"},
      {"requirement_ids": ["R2", "R3", "R5"], "signal": "授权与回归测试通过", "method": "system/release 测试"}
    ],
    "assumptions": [{"text": "rel project_id 对应 pm_project.project_code", "basis": "现有写入和顶部 ref", "falsifier": "存量记录无法关联"}],
    "unknowns": [],
    "decisions": [
      {"id": "D1", "decision": "显式项目参数和统一服务", "reason": "边界清楚", "source": "用户确认"},
      {"id": "D2", "decision": "直接链接有权切换、无权拒绝", "reason": "上下文一致", "source": "用户确认"}
    ],
    "risks": [
      {"risk": "存量项目编码异常", "impact": "历史数据被拒绝", "mitigation": "实施前验证并设置停止条件"},
      {"risk": "异步串项目", "impact": "显示错误数据", "mitigation": "请求代次和项目比较"}
    ],
    "approval": {"status": "approved", "evidence": "用户于 2026-08-31 同意按推荐方案处理。", "confirmed_at": "2026-08-31T18:23:52+08:00"}
