    "human_document": "docs/engineering-control/designs/2026-09-05-architecture-remaining-project-scope-design.md",
    "objective": "将网络专项工单、网络分区及网段、网络访问全链路和架构决策接入顶部当前项目，形成数据库、服务、流程、通知、附件和前端状态的完整项目隔离。",
    "users": ["当前项目的架构维护人员", "网络专项工单申请人与处理人", "网络访问申请人与审批人", "架构决策发起人与评审人", "超级管理员"],
    "requirements": [
      {
        "id": "R1",
        "statement": "四类业务主数据及关键子数据必须显式保存项目归属。",
        "acceptance": ["项目列非空", "读写限定 tenant_id 与 project_id", "直接 ID 不跨项目"],
        "priority": "must",
        "source": "批准设计",
        "counterexample": ["Store 仅按 tenant_id 和 id 查询"]
      },
      {
        "id": "R2",
        "statement": "目标接口必须强制 projectRef 并校验项目访问权、RBAC 和实体归属。",
        "acceptance": ["缺项目 400", "无权限 403", "其他项目实体 404"],
        "priority": "must",
        "source": "批准设计",
        "counterexample": ["前端显隐替代服务端授权"]
      },
      {
        "id": "R3",
        "statement": "业务编号、分区编码名称和外部地址必须项目内永久唯一。",
        "acceptance": ["跨项目允许重复", "同项目重复和软删除后复用被拒绝"],
        "priority": "must",
        "source": "批准设计",
        "counterexample": ["租户级唯一索引"]
      },
      {
        "id": "R4",
        "statement": "网络分区、网段、访问关系、实例、工单、决策和结论禁止跨项目引用。",
        "acceptance": ["候选仅当前项目", "伪造 ID 被拒绝", "数据库无跨项目活动关系"],
        "priority": "must",
        "source": "批准设计",
        "counterexample": ["项目 A 引用项目 B 分区或结论"]
      },
      {
        "id": "R5",
        "statement": "网络工单、网络访问申请和架构决策工作流必须绑定业务项目。",
        "acceptance": ["上下文包含 projectRef/projectName", "业务与实例项目一致", "不一致回调不更新"],
        "priority": "must",
        "source": "批准设计",
        "counterexample": ["WorkflowBusinessContext 项目为空"]
      },
      {
        "id": "R6",
        "statement": "通知、附件和事件不得泄露或关联其他项目数据。",
        "acceptance": ["通知重新鉴权", "附件策略校验业务项目", "幂等身份包含项目"],
        "priority": "must",
        "source": "批准设计",
        "counterexample": ["凭附件 ID 下载其他项目文件"]
      },
      {
        "id": "R7",
        "statement": "历史数据只迁入 RDDMP-PLATFORM，默认项目异常时迁移失败。",
        "acceptance": ["项目列无空值", "不复制到其他项目", "缺失或不唯一阻止迁移"],
        "priority": "must",
        "source": "批准设计",
        "counterexample": ["自动选择其他项目"]
      },
      {
        "id": "R8",
        "statement": "存在新增项目化架构数据时必须阻止删除项目。",
        "acceptance": ["guard 覆盖目标主表", "有引用 409", "无引用保持原行为"],
        "priority": "must",
        "source": "批准设计",
        "counterexample": ["删除后遗留孤立数据"]
      },
      {
        "id": "R9",
        "statement": "页面跟随顶部项目并在切换时清除旧项目状态。",
        "acceptance": ["无第二选择器", "无项目不请求", "旧请求和页面状态不残留"],
        "priority": "must",
        "source": "批准设计",
        "counterexample": ["旧响应覆盖新项目列表"]
      },
      {
        "id": "R10",
        "statement": "架构规范、计划模板、环境类型和平台字典继续租户共享。",
        "acceptance": ["共享接口不强制项目", "共享表无 project_id", "不同项目看到相同共享配置"],
        "priority": "must",
        "source": "批准设计",
        "counterexample": ["把共享配置复制到项目"]
      },
      {
        "id": "R11",
        "statement": "LocalSeededWorkflowPublisher 保持租户级定义发布并覆盖三条业务流程。",
        "acceptance": ["定义不按项目复制", "三条草稿定义可发布", "平台工作流源码不修改"],
        "priority": "must",
        "source": "批准设计",
        "counterexample": ["每项目发布重复定义"]
      },
      {
        "id": "R12",
        "statement": "数据库、后端和前端同批发布并具有可验证回退方案。",
        "acceptance": ["V158 只追加", "上线前备份和预检查", "失败时整批回退或恢复备份"],
        "priority": "must",
        "source": "批准设计",
        "counterexample": ["只上线后端导致旧前端缺 projectRef"]
      }
    ],
    "invariants": [
      "tenant_id 与 project_id 来自服务端可信上下文",
      "业务 DTO 不接收 tenantId 或 projectId",
      "architecture 不直接写 system、workflow 或 attachment 私有表",
      "父子和跨业务引用必须同租户同项目",
      "工作流定义租户共享、业务实例项目私有",
      "共享架构配置不增加 project_id",
      "历史 Flyway 与 Flowable ACT_* 不修改",
      "不得覆盖 REQ-20260905-064 未提交修改"
    ],
    "constraints": [
      "Java 17、Spring Boot 3.4.4、MySQL 8.4、Vue 3",
      "复用 ProjectAccessService、ProjectDeletionGuard、WorkflowBusinessGateway 和 AttachmentAccessPolicy",
      "Flyway 只追加且 V158 未占用才允许实施",
      "前端遵循 design-h5.md 和架构目录 AGENTS.md",
      "只使用本地虚构测试数据"
    ],
    "non_goals": [
      "跨项目共享、复制或转移业务数据",
      "项目化架构规范、计划模板、环境类型或平台字典",
      "新增项目级架构角色",
      "修改工作流或附件平台内部实现",
      "重命名稳定技术契约"
    ],
    "selected_approach": {
      "name": "全链路显式项目归属",
      "reason": "数据库约束、直接 ID、附件策略和生命周期回调均可明确验证。",
      "alternatives": [
        {"name": "根实体推导", "rejected_because": "子数据直接访问和回调容易遗漏项目条件。"},
        {"name": "项目绑定关系表", "rejected_because": "与单项目独占不一致并增加唯一性复杂度。"}
      ]
    },
    "architecture": {
      "boundary": {
        "inside": ["business/architecture 网络与决策链", "architecture 项目删除 guard", "boot 本地流程定义发布", "架构前端页面", "V158 与 Mock"],
        "outside": ["Flowable ACT_*", "platform/workflow 内部实现", "platform/attachment 内部实现", "生产系统和真实数据"]
      },
      "components": [
        {"name": "前端项目上下文", "responsibility": "提供 current projectRef 并在切换时清理状态", "depends_on": ["useProjectContextStore"]},
        {"name": "目标 Controller", "responsibility": "强制 projectRef 和原有 RBAC", "depends_on": ["ProjectAccessService"]},
        {"name": "网络与决策 Service/Store", "responsibility": "同项目业务规则及 tenant_id + project_id 持久化", "depends_on": ["ProjectAccess"]},
        {"name": "工作流提交和生命周期消费者", "responsibility": "保持业务、实例、轮次和回调项目一致", "depends_on": ["WorkflowBusinessGateway"]},
        {"name": "附件访问策略", "responsibility": "从业务实体恢复项目并校验用户访问", "depends_on": ["AttachmentAccessPolicy"]},
        {"name": "项目删除 guard", "responsibility": "删除前检查目标主表", "depends_on": ["ProjectDeletionGuard"]},
        {"name": "LocalSeededWorkflowPublisher", "responsibility": "每租户发布三条流程定义且不按项目复制", "depends_on": ["流程定义发布公开接口"]}
      ],
      "interfaces": [
        {"name": "ProjectAccessService", "producer": "platform/system", "consumers": ["business/architecture"], "contract": "按 projectRef 校验租户和成员并返回可信项目"},
        {"name": "ProjectDeletionGuard", "producer": "platform/system", "consumers": ["business/architecture"], "contract": "项目删除前调用业务引用检查"},
        {"name": "WorkflowBusinessGateway", "producer": "platform/workflow", "consumers": ["business/architecture"], "contract": "项目上下文固化工作流实例项目"},
        {"name": "AttachmentAccessPolicy", "producer": "platform/attachment", "consumers": ["business/architecture"], "contract": "按业务键和用户判定附件操作授权"}
      ],
      "data_flows": [
        {"input": "projectRef 与认证用户", "transitions": ["项目访问校验", "实体和关联项目校验", "项目限定读写"], "output": "当前项目数据或明确错误"},
        {"input": "项目业务提交", "transitions": ["构造项目工作流上下文", "实例固化项目", "生命周期项目复核"], "output": "项目隔离的流程和业务状态"},
        {"input": "附件业务键", "transitions": ["加载项目化业务实体", "校验项目访问和状态"], "output": "允许或拒绝附件操作"},
        {"input": "历史目标数据", "transitions": ["查找唯一默认项目", "父链回填", "完整性校验", "非空与组合约束"], "output": "明确项目归属"}
      ]
    },
    "error_handling": [
      {"condition": "projectRef 缺失", "behavior": "400，前端不发送目标业务请求", "recovery": "选择项目后重试"},
      {"condition": "无项目访问权或缺少 RBAC", "behavior": "403", "recovery": "申请成员或动作权限"},
      {"condition": "实体不属于当前项目", "behavior": "列表隐藏，详情和写操作 404", "recovery": "返回当前项目列表"},
      {"condition": "跨项目引用", "behavior": "400 且不写入", "recovery": "选择当前项目对象"},
      {"condition": "工作流项目不一致", "behavior": "拒绝启动或消费，不改变业务状态", "recovery": "修正上下文或人工处理失败事件"},
      {"condition": "附件业务项目不可访问", "behavior": "拒绝预览、下载或删除", "recovery": "切换到有权项目或申请权限"},
      {"condition": "默认项目缺失、不唯一或迁移数据异常", "behavior": "Flyway 失败", "recovery": "修复前置数据后重新发布"},
      {"condition": "项目存在目标业务数据", "behavior": "项目删除 409", "recovery": "先按业务规则处理数据"}
    ],
    "quality_attributes": {
