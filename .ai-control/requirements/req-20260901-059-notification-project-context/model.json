  },
  "state_variables": [
    {"name": "notification_project_context", "owner": "platform/system", "valid_values": ["projectRef/projectName both present", "both null"]},
    {"name": "workflow_project_context", "owner": "platform/workflow", "valid_values": ["project snapshot pair", "both null"]},
    {"name": "notification_scope_label", "owner": "frontend/application", "valid_values": ["所属项目", "所属范围"]}
  ],
  "causal_paths": [
    {"requirement_id": "R1", "input": "通知发布命令", "transitions": ["成对校验与规范化", "sys_notification 持久化", "按接收用户查询映射"], "outputs": ["包含可空 projectRef/projectName 的通知响应"]},
    {"requirement_id": "R2", "input": "工作流任务分配或生命周期结果", "transitions": ["读取已有工作流项目上下文", "构造通知发布命令", "系统通知持久化"], "outputs": ["项目归属完整的工作流通知"]},
    {"requirement_id": "R3", "input": "V133 迁移", "transitions": ["新增可空列", "按 workflow-task 事件关联 wf_task/wf_instance", "按 workflow-lifecycle 事件关联 wf_lifecycle_event"], "outputs": ["可靠关联的存量通知获得项目快照"]},
    {"requirement_id": "R4", "input": "通知分页响应", "transitions": ["项目字段判定", "渲染归属行", "响应式换行"], "outputs": ["桌面与移动端可读的项目归属"]}
  ],
  "interfaces": [
    {"name": "NotificationPublishCommand", "producers": ["业务模块与工作流桥接"], "consumers": ["SystemNotificationPublisher"], "invariant": "项目字段成对且旧 13 参数构造器保持兼容"},
    {"name": "GET /api/notifications item", "producers": ["SystemNotificationService"], "consumers": ["UiNotificationCenter"], "invariant": "projectRef/projectName 均存在或均为空"},
    {"name": "workflow project snapshot", "producers": ["platform/workflow"], "consumers": ["WorkflowSystemNotificationBridge"], "invariant": "不从通知文本推断项目"}
  ],
  "sensors": [
    {"id": "S1", "target": "R1 通知契约和持久化查询", "method": "ccb-system 单元测试", "blind_spots": ["真实 MySQL 方言"], "independence": "Mock JDBC 参数与响应映射断言"},
    {"id": "S2", "target": "R2 工作流桥接", "method": "ccb-boot 单元测试", "blind_spots": ["定时调度时间"], "independence": "记录实际发布命令"},
    {"id": "S3", "target": "R3 迁移", "method": "本地 MySQL Flyway 执行与信息架构/数据查询", "blind_spots": ["外部生产数据分布"], "independence": "真实数据库观测"},
    {"id": "S4", "target": "R4 用户可见布局", "method": "桌面与 390x844 浏览器 DOM、截图、宽度和控制台检查", "blind_spots": ["未抽样的设备字体差异"], "independence": "真实渲染输出"},
    {"id": "S5", "target": "共享契约回归", "method": "Maven 聚焦测试与前端生产构建", "blind_spots": ["未执行的全仓测试"], "independence": "编译器与测试运行器"}
