    {"id": "A2", "target": "工作流通知组合根", "action": "从既有上下文传递项目快照", "authority": "REQ-059 writable_paths", "impact_radius": "工作流站内通知", "rollback": "回退桥接改动"},
    {"id": "A3", "target": "sys_notification 模式与存量数据", "action": "追加 V133 可空列和精确回填", "authority": "REQ-059 migration scope", "impact_radius": "本地/部署数据库通知表", "rollback": "应用兼容性回退，物理列保留"},
