  "design": {
    "schema_version": 1,
    "topic": "data-migration-release-drill",
    "design_revision": 1,
    "design_status": "approved",
    "human_document": "docs/engineering-control/designs/2026-09-05-data-migration-release-drill-design.md",
    "objective": "将数据迁移/数迁资产内容/投产及演练从通用文件资产薄页升级为参数管理码值、单文件、组件级单选系统、手填轮次、逻辑删除和统一回收站的专属域功能。",
    "users": [
      "数据迁移管理员：维护投产及演练资料并管理统一回收站",
      "普通数据迁移人员：查看、下载、上传并维护本人资料"
    ],
    "requirements": [
      {
        "id": "R1",
        "statement": "dm_release_drill保存颗粒度/资料类型/所属轮次/资料名称，组件级必填一个系统，新增必填一个源文件，轮次手填可空。",
        "acceptance": ["必填缺失400", "项目级传系统400", "组件级缺系统400", "轮次可空"],
        "priority": "must",
        "source": "用户功能说明与确认",
        "counterexample": ["只保存doc_name和system_code"]
      },
      {
        "id": "R2",
        "statement": "颗粒度与资料类型由系统管理参数维护，V184初始化DM_RELEASE_DRILL_GRANULARITY和DM_RELEASE_DRILL_TYPE。",
        "acceptance": ["参数选项接口可读", "停用/未知编码拒绝", "重复执行不覆盖管理员配置"],
        "priority": "must",
        "source": "用户确认Granularity指向参数管理",
        "counterexample": ["硬编码颗粒度/类型"]
      },
      {
        "id": "R3",
        "statement": "列表展示涉及物理子系统和所属轮次。",
        "acceptance": ["列表返回system_code/system_name/drill_round", "组件级名称经投影"],
        "priority": "must",
        "source": "用户确认列表展示两列",
        "counterexample": ["仅表单可见"]
      },
      {
        "id": "R4",
        "statement": "一个资料只绑定一个源文件，新增必传，编辑保留或替换。",
        "acceptance": ["新增无文件400", "编辑不传新文件保留", "编辑传新文件替换"],
        "priority": "must",
        "source": "用户确认单文件",
        "counterexample": ["多文件"]
      },
      {
        "id": "R5",
        "statement": "列表支持颗粒度/资料类型/名称关键字组合筛选和服务端分页，覆盖加载/空/失败/无权限/提交中状态。",
        "acceptance": ["筛选回第一页", "分页20/50/100", "项目切换重置"],
        "priority": "must",
        "source": "用户功能说明",
        "counterexample": ["浏览器内存筛选"]
      },
      {
        "id": "R6",
        "statement": "所有功能纳入权限管理，写操作执行项目隔离/实体授权/审计。",
        "acceptance": ["跨项目拒绝", "普通用户仅本人记录", "RELEASE_DRILL_*审计"],
        "priority": "must",
        "source": "REQ-031统一规则",
        "counterexample": ["仅前端隐藏按钮"]
      },
      {
        "id": "R7",
        "statement": "RELEASE_DRILL由ReleaseDrillRecycleBinSource唯一认领并摘除通用链路。",
        "acceptance": ["通用控制器无release-drills", "MANAGED_TYPES无RELEASE_DRILL", "回收站无重复"],
        "priority": "must",
        "source": "专题/迁移方案收敛模式",
        "counterexample": ["双来源"]
      },
      {
        "id": "R8",
        "statement": "邻接修改限定在数据迁移模块与V184。",
        "acceptance": ["不跨投产模块", "不修改平台公共构件", "构建/治理通过"],
        "priority": "must",
        "source": "REQ-031范围",
        "counterexample": ["依赖投产模块"]
      }
    ],
    "invariants": [
      "单租户且绑定当前项目与tenant_id",
      "Flyway只追加使用V184",
      "业务关联使用(project_id, system_code)",
      "doc_code服务端生成",
      "参数INSERT IGNORE"
    ],
    "constraints": [
      "模块边界遵循modules.yaml",
      "不依赖投产模块",
      "不修改系统参数私有实现",
      "文件单个≤50MB",
      "遵守design-h5.md和共享UI"
    ],
    "non_goals": [
      "轮次下拉来自投产模块",
      "多文件/多系统",
      "新增业务字典表",
      "修改全局项目切换器"
    ],
    "selected_approach": {
      "name": "专属服务+参数管理+单文件单系统+V184",
      "reason": "与迁移方案/专题材料一致",
      "alternatives": [
        {"name": "通用AssetListView", "rejected_because": "无法表达字段联动且弱化校验"},
        {"name": "独立字典表", "rejected_because": "与参数管理冲突"}
      ]
    },
    "architecture": {
      "boundary": {
        "inside": ["dm_release_drill字段", "参数初始化", "ReleaseDrillService/Controller/RecycleBinSource", "前端页面API"],
        "outside": ["投产模块", "platform/system参数实现", "全局项目切换器", "公共附件审计表结构"]
      },
      "components": [
        {"name": "ReleaseDrillService", "responsibility": "CRUD/筛选/校验/附件/审计/回收站", "depends_on": ["DataMigrationPermissionService", "ContentAttachmentService", "DataMigrationCodeValueService", "ContentDocCodeGenerator"]},
        {"name": "ReleaseDrillController", "responsibility": "路由与权限", "depends_on": ["ReleaseDrillService"]},
        {"name": "ReleaseDrillRecycleBinSource", "responsibility": "统一回收站认领", "depends_on": ["ReleaseDrillService"]},
        {"name": "ReleaseDrillsPage", "responsibility": "列表/筛选/抽屉/上传/下载/删除", "depends_on": ["data-migration.ts"]}
      ],
      "interfaces": [
        {"name": "GET /api/data-migration/release-drills", "producer": "ReleaseDrillController", "consumers": ["ReleaseDrillsPage"], "contract": "list(projectId,granularity,materialTypeCode,keyword,page,size)"},
        {"name": "POST/PUT/DELETE /api/data-migration/release-drills[/{id}]", "producer": "ReleaseDrillController", "consumers": ["ReleaseDrillsPage"], "contract": "create/update/delete with RBAC/project/attachment checks"},
        {"name": "GET /api/data-migration/release-drills/options/systems", "producer": "ReleaseDrillController", "consumers": ["ReleaseDrillsPage"], "contract": "component options"},
        {"name": "GET /api/data-migration/options/{category}", "producer": "DataMigrationParameterOptionsController", "consumers": ["ReleaseDrillsPage"], "contract": "granularity/material type options"}
      ],
      "data_flows": [
        {"input": "当前项目+元数据+单文件", "transitions": ["附件校验", "参数/系统校验", "写入dm_release_drill", "绑定附件", "写审计"], "output": "详情/列表"},
        {"input": "筛选条件", "transitions": ["项目隔离", "组合查询", "系统名称投影"], "output": "分页列表"}
      ]
    },
    "error_handling": [
      {"condition": "必填/组件级缺系统", "behavior": "400", "recovery": "前端标红"},
      {"condition": "参数未启用", "behavior": "400", "recovery": "提示启用后重试"},
      {"condition": "附件无效/超限", "behavior": "400", "recovery": "重新上传"},
      {"condition": "越权/跨项目", "behavior": "403/守卫拒绝", "recovery": "切换项目"},
      {"condition": "回收站恢复冲突", "behavior": "409", "recovery": "刷新查看"}
    ],
    "quality_attributes": {
      "security": ["RBAC", "项目守卫", "实体授权", "附件校验", "审计"],
      "performance": ["系统选项一次返回", "服务端分页"],
      "compatibility": ["ContentAssetTables保留RELEASE_DRILL", "回收站不回退认领"],
      "operations": ["V184幂等", "INSERT IGNORE"]
    },
    "verification_strategy": [
      {"requirement_ids": ["R1","R4","R6"], "signal": "Service/Controller测试", "method": "mvn -pl :ccb-data-migration -am -Dtest=ReleaseDrillServiceTest,ReleaseDrillControllerSecurityTest test"},
      {"requirement_ids": ["R2"], "signal": "码值/迁移测试", "method": "mvn -pl :ccb-data-migration -am -Dtest=DataMigrationCodeValueServiceTest,ContentAssetMigrationMySqlTest test"},
      {"requirement_ids": ["R7"], "signal": "回收站注册测试", "method": "mvn -pl :ccb-data-migration -am -Dtest=DataMigrationModuleRegistrationTest,ReleaseDrillRecycleBinSourceTest test"},
      {"requirement_ids": ["R3","R5"], "signal": "前端构建/浏览器验收", "method": "npm --prefix web run build"},
      {"requirement_ids": ["R8"], "signal": "全量回归", "method": "mvn -pl :ccb-data-migration -am test && node scripts/check-all-governance.mjs && npm --prefix web run build"}
    ],
    "assumptions": [
      {"text": "dm_release_drill当前无存量业务行", "basis": "REQ-031本地表行数0", "falsifier": "发现存量业务行"},
      {"text": "组件级等价dm_component一个启用记录", "basis": "迁移方案/专题模式", "falsifier": "需其他系统模型"},
      {"text": "编辑不传新文件保留原文件", "basis": "附件策略", "falsifier": "用户要求编辑必须重新上传"}
    ],
    "unknowns": [
      {"question": "是否存在需要保留的旧记录", "impact": "V184默认值可能不符合历史语义", "owner": "module-owner", "blocking": false}
    ],
    "decisions": [
      {"id": "D1", "decision": "轮次纯手工输入", "reason": "用户确认且避免跨模块", "source": "用户消息"},
      {"id": "D2", "decision": "组件级单选系统", "reason": "参考迁移方案", "source": "用户消息"},
      {"id": "D3", "decision": "源文件单文件", "reason": "一个资评对应一份文档", "source": "用户消息"},
      {"id": "D4", "decision": "颗粒度/类型走参数管理", "reason": "用户确认", "source": "用户消息"}
    ],
    "risks": [
