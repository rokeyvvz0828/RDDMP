  "disturbances": [
    {
      "source": "最终表模式跨多次Flyway域化",
      "effect": "初始表DDL与当前列名不同",
      "detectable": true,
      "controllable": true
    },
    {
      "source": "MySQL冷缓存、数据倾斜和本机负载",
      "effect": "P95波动",
      "detectable": true,
      "controllable": false
    },
    {
      "source": "快速项目切换与慢请求乱序",
      "effect": "旧项目数据污染",
      "detectable": true,
      "controllable": true
    },
    {
      "source": "ECharts/ResizeObserver和抽屉挂载时序",
      "effect": "图表空白或泄漏",
      "detectable": true,
      "controllable": true
    },
    {
      "source": "用户现有未提交设计计划修改",
      "effect": "新worktree无法自然继承",
      "detectable": true,
      "controllable": true
    },
    {
      "source": "REQ-061畸形scope文件",
      "effect": "全局治理检查失败",
      "detectable": true,
      "controllable": false
    }
  ],
  "delays": [
    {
      "source": "最多4路指标队列",
      "consequence": "后续指标等待前批完成",
      "sampling_rule": "从首请求开始至13项最终响应测量总完成耗时"
    },
    {
      "source": "数据库连接池与查询",
      "consequence": "单项响应受并发和缓存影响",
      "sampling_rule": "预热后重复采样并报告P95与环境"
    },
    {
      "source": "滚动临界点",
      "consequence": "连续scroll事件可能重复触发",
      "sampling_rule": "观察每一page只存在一个在途请求"
    },
    {
      "source": "项目切换取消",
      "consequence": "取消与旧响应回调竞争",
      "sampling_rule": "慢请求期间切换并确认代次校验后再读取DOM"
    }
  ],
  "assumptions": [
    {
      "text": "当前专用需求分支可作为隔离边界",
      "evidence": "任务scope指定同名分支且当前分支匹配，批准文档为未提交工作区改动",
      "falsifier": "发现该分支被其他并行任务写入相同文件"
    },
    {
      "text": "现有tenant/project前缀索引足够",
      "evidence": "V161/V162/V168/V180/V184/V185/V186/V194/V197包含相关索引",
      "falsifier": "EXPLAIN ANALYZE无项目约束或P95超标"
    },
    {
      "text": "统一摘要投影满足下钻核查",
      "evidence": "批准设计明确统一id/code/name/granularity/systemCode/updatedAt",
      "falsifier": "用户要求领域全字段或编辑"
    }
  ],
