    "objective": "将数迁资产内容的迁移映射升级为独立业务域，使一条受权限保护的映射记录绑定多个不超过50MB的文件，并提供受控码值、项目系统、组合筛选、下载和统一回收站能力。",
    "users": ["数据迁移管理员维护当前项目全部映射和回收站", "普通人员查看下载当前项目映射并在有权限时维护本人记录"],
    "requirements": [
      {"id": "R1", "statement": "映射类型、系统编号和文件名称必填，文件名称最多200字符，文件编号由服务端生成且不可修改。", "acceptance": ["缺少必填字段或名称超长返回400", "成功记录具有不可编辑文件编号"], "priority": "must", "source": "用户需求及2026-09-06确认", "counterexample": ["缺少系统编号仍创建成功"]},
      {"id": "R2", "statement": "映射类型来自启用的DM_MAPPING_TYPE参数，预置迁出程序和迁入程序，前端不硬编码。", "acceptance": ["选项接口返回启用参数", "停用或未知类型拒绝写入"], "priority": "must", "source": "用户需求及2026-09-06确认", "counterexample": ["停用类型仍可保存"]},
      {"id": "R3", "statement": "系统编号只能选择当前项目dm_component启用清单中的系统。", "acceptance": ["项目外或停用系统被拒绝", "切换项目清空旧系统和数据"], "priority": "must", "source": "用户需求及2026-09-06确认", "counterexample": ["可提交其他项目系统"]},
      {"id": "R4", "statement": "一条迁移映射记录绑定多个普通文件或压缩包，新增至少一个附件，每个附件不超过50MB且服务端不解压。", "acceptance": ["一条记录绑定多个附件", "无附件或单文件超过50MB被拒绝", "压缩包原样保存"], "priority": "must", "source": "用户2026-09-06明确确认", "counterexample": ["每个文件生成独立映射记录"]},
      {"id": "R5", "statement": "列表展示系统、映射类型、文件编号和文件名称，并按三项组合筛选及服务端分页。", "acceptance": ["三个条件可组合", "名称只做有限字段模糊匹配", "筛选回第一页且分页为20/50/100"], "priority": "must", "source": "用户需求及确认设计", "counterexample": ["关键字扫描无关字段"]},
      {"id": "R6", "statement": "编辑支持元数据和附件保留、追加、移除；下载支持指定附件和全部附件ZIP。", "acceptance": ["附件集合更新一致", "单附件不能跨记录下载", "ZIP包含全部活动附件"], "priority": "must", "source": "用户确认设计", "counterexample": ["编辑自动丢失旧附件"]},
      {"id": "R7", "statement": "MAPPING_DOC由专属来源唯一接入统一回收站并保持业务记录、附件和审计一致。", "acceptance": ["回收站只出现一次", "恢复保留附件", "彻底清理附件和业务记录但保留审计"], "priority": "must", "source": "用户需求及确认设计", "counterexample": ["通用和专属来源重复认领"]},
      {"id": "R8", "statement": "查看、下载、上传新增、编辑、删除和回收站管理执行服务端RBAC、租户、项目、实体和附件归属校验并审计成功写操作。", "acceptance": ["匿名无权跨项目和非所有者请求被拒绝", "成功写操作有MAPPING审计"], "priority": "must", "source": "用户权限需求及确认设计", "counterexample": ["仅前端隐藏按钮控制权限"]},
      {"id": "R9", "statement": "页面覆盖全状态、多文件部分失败重试和响应式布局，并通过工程和真实浏览器验证。", "acceptance": ["失败文件可单独重试且成功项保留", "桌面和三个手机视口无页面级横向溢出", "构建治理范围检查有真实结果"], "priority": "must", "source": "RDDMP规则及用户确认设计", "counterexample": ["上传失败无法定位文件"]},
      {"id": "R10", "statement": "当前dm_mapping_doc无历史数据，追加迁移不执行历史回填或兼容默认值。", "acceptance": ["V186没有历史回填SQL", "新记录必须提供新字段"], "priority": "must", "source": "用户2026-09-06明确确认", "counterexample": ["旧记录默认回填迁入程序"]}
    ],
    "invariants": ["租户和操作者来自认证主体且访问绑定当前项目", "doc_code服务端生成且不可修改", "Flyway只追加", "业务表不保存对象键或凭据", "MAPPING_DOC只有一个回收站来源"],
    "constraints": ["类型来自启用DM_MAPPING_TYPE", "系统来自当前项目启用dm_component", "单附件上限52428800字节", "不修改平台公共实现", "前端遵循公共UI和design-h5"],
    "non_goals": ["不解压压缩包", "不实现版本历史查重或在线编辑", "不拆分多文件为多条记录", "不重构其他内容菜单", "不迁移历史数据"],
    "selected_approach": {"name": "独立迁移映射服务和页面并复用公共能力", "reason": "隔离映射专属规则并保持平台及其他菜单稳定", "alternatives": [{"name": "扩展通用文件链路", "rejected_because": "会污染通用服务并扩大回归面"}, {"name": "抽象程序和映射统一服务", "rejected_because": "属于超范围跨菜单重构"}]},
    "architecture": {
      "boundary": {"inside": ["dm_mapping_doc和MAPPING_DOC附件关系", "Mapping后端和页面", "当前任务测试账本"], "outside": ["平台附件参数权限实现", "全局项目切换器", "其他业务菜单", "生产环境"]},
      "components": [{"name": "MappingService", "responsibility": "CRUD筛选多附件下载授权审计和回收站业务", "depends_on": ["JdbcTemplate", "ContentAttachmentService", "DataMigrationCodeValueService", "DataMigrationPermissionService"]}, {"name": "MappingController", "responsibility": "专属HTTP和RBAC", "depends_on": ["MappingService", "AttachmentStreamService"]}, {"name": "MappingRecycleBinSource", "responsibility": "唯一认领MAPPING_DOC", "depends_on": ["MappingService"]}, {"name": "MappingsPage.vue", "responsibility": "桌面移动列表、筛选、附件状态和操作", "depends_on": ["data-migration API", "公共UI", "项目上下文"]}],
      "interfaces": [{"name": "Mapping REST", "producer": "MappingController", "consumers": ["MappingsPage.vue"], "contract": "当前项目分页CRUD附件下载和选项"}, {"name": "统一回收站SPI", "producer": "MappingRecycleBinSource", "consumers": ["ContentRecycleBinController"], "contract": "MAPPING_DOC查询恢复彻底清理"}],
      "data_flows": [{"input": "当前项目", "transitions": ["加载类型和系统", "分页查询"], "output": "项目隔离列表"}, {"input": "元数据和多个文件", "transitions": ["逐文件上传", "服务端校验", "事务绑定", "审计"], "output": "多附件映射"}, {"input": "删除记录", "transitions": ["统一回收站", "恢复或清理"], "output": "恢复记录或保留审计的清理结果"}]
    },
    "error_handling": [{"condition": "必填大小码值或系统错误", "behavior": "400且不写成功审计", "recovery": "保留表单修正重试"}, {"condition": "无权跨项目或附件归属错误", "behavior": "403或受控错误", "recovery": "展示无权限"}, {"condition": "部分上传失败", "behavior": "保留成功和失败状态且不提交不完整新增", "recovery": "只重试失败项"}, {"condition": "并发或恢复冲突", "behavior": "409不覆盖", "recovery": "刷新重试"}, {"condition": "ZIP读取失败", "behavior": "终止且不返回不完整成功包", "recovery": "修复附件或单独下载"}],
    "quality_attributes": {"security": ["服务端RBAC项目实体附件校验", "成功写操作审计"], "performance": ["选项一次加载本地筛选", "服务端分页组合索引", "流式ZIP"], "compatibility": ["保留MAPPING_DOC类型", "不改平台契约", "无虚假历史默认"], "operations": ["MySQL 8.4追加迁移", "应用回退保留迁移", "不访问生产"]},
    "verification_strategy": [{"requirement_ids": ["R1", "R2", "R3", "R4", "R6", "R7", "R8", "R10"], "signal": "MySQL和JUnit验证数据后端权限附件回收站", "method": "迁移和聚焦测试"}, {"requirement_ids": ["R5", "R9"], "signal": "构建和四视口浏览器无错误无溢出", "method": "Vue构建与Playwright"}, {"requirement_ids": ["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8", "R9", "R10"], "signal": "工程范围回归收敛", "method": "Maven治理范围和运行检查"}],
