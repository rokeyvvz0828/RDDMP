    "selected_approach": {"name": "Independent data-migration business module", "reason": "The V3 domain owns its data and can consume existing public platform contracts without contaminating platform modules.", "alternatives": ["putting business tables in system was rejected", "reusing the abandoned asset design was rejected"]},
