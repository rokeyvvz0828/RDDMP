      {"id": "R2", "statement": "Project, component, target-table and intermediate-table base data management", "acceptance": ["project and component uniqueness", "Excel import/export", "relation-safe deletion"], "priority": "must", "source": "V3", "counterexample": ["free-text project references", "cross-project component collision"]},
