      {"id": "R5", "statement": "Structured rules, parameters, issues and table fields use independent DTOs and tables", "acceptance": ["code validation", "field-specific search", "ownership enforcement"], "priority": "must", "source": "V3", "counterexample": ["biz_form metadata", "unvalidated JSON passthrough"]},
      {"id": "R6", "statement": "Bounded Excel import/export and deterministic dashboard drill-down mappings", "acceptance": ["5000 row and 50MB limits", "per-row failures", "valid XLSX exports", "filters carried to detail"], "priority": "must", "source": "V3 and design", "counterexample": ["unbounded workbook", "silent row loss"]},
      {"id": "R7", "statement": "Additive MySQL and MinIO lifecycle are consistent and recoverable", "acceptance": ["V35 only", "object key hidden", "replace compensation", "rollback retains data"], "priority": "must", "source": "repository rules and design", "counterexample": ["editing old migration", "orphaning current file"]},
      {"id": "R8", "statement": "Responsive real frontend works without Mock runtime data", "acceptance": ["desktop and three mobile viewports", "all async states", "real backend and menu", "no page overflow"], "priority": "must", "source": "repository rules and user approval", "counterexample": ["mock-only UI", "desktop table squeezed into mobile"]}
