    "objective": "在现有 architecture 模块内建立逻辑与物理子系统从申请、确定性编号、真实审批到原子发布、状态约束和完整历史的全生命周期闭环。",
    "users": [
      "查看者：查看当前租户全部发布子系统和本人申请",
      "申请人：创建、编辑、提交和取消本人申请",
      "架构管理员：包含申请能力并审批全部申请，可自申请自审批"
    ],
    "requirements": [
      {
        "id": "R1",
        "statement": "逻辑和物理主数据必须保留租户内分页查询、状态筛选、详情和双向关联，只展示已发布事实。",
        "acceptance": ["view 用户可查询当前租户全部发布记录", "状态和双向关联刷新后与数据库一致", "无权限和跨租户被拒绝"],
        "priority": "must",
        "source": "用户确认与现有主数据兼容要求",
        "counterexample": ["列表混入草稿或审批中值", "物理详情无法确认所属逻辑"]
      },
      {
        "id": "R2",
        "statement": "逻辑和物理的新增、修改、下线、重新启用、作废必须经过强类型工单，只有 APPROVED 事件可以写发布主记录。",
        "acceptance": ["DRAFT/IN_REVIEW/RETURNED/REJECTED/CANCELLED 不改变主数据", "审批人只能批准、退回、拒绝", "申请快照、差异和历史可追踪"],
        "priority": "must",
        "source": "用户确认",
        "counterexample": ["管理员直接写主表", "审批时修改提交字段"]
      },
      {
        "id": "R3",
        "statement": "逻辑 CREATE 工单必须支持可选 0..N 个物理草稿，并在批准时原子发布；已发布逻辑支持独立物理 CREATE。",
        "acceptance": ["0、1、多条物理均可提交", "任一子项失败时零主记录新增", "物理行按稳定顺序编号"],
        "priority": "must",
        "source": "用户纠正并确认",
        "counterexample": ["强制至少一条物理", "逐条发布造成部分成功"]
      },
      {
        "id": "R4",
        "statement": "编号采用策略模式；逻辑为 A+4 位全局序号，物理为 W+逻辑 4 位序号+1..9/A..Z 槽位，首次提交分配并按规则保留、释放或永久占用。",
        "acceptance": ["并发不重号", "最小释放值优先复用", "RETURNED 保留", "已发布/下线/作废编号不复用", "既有 code 不改写"],
        "priority": "must",
        "source": "用户确认",
        "counterexample": ["草稿即占号", "批准编号被再次分配", "物理超过 35 后静默重号"]
      },
      {
        "id": "R5",
        "statement": "同一发布目标最多一张已提交未结束申请；物理普通更新不得改父级，归属迁移必须以 REPLACE 原子新建目标记录并下线旧记录。",
        "acceptance": ["并发提交仅一张取得锁", "RETURNED 保留锁", "替换关系和新旧编号可追踪"],
        "priority": "must",
        "source": "用户确认",
        "counterexample": ["两张 IN_REVIEW 指向同一目标", "直接更新 logicalSubsystemId"]
      },
      {
        "id": "R6",
        "statement": "下线可恢复且阻止新引用；作废不可逆且要求无有效引用；逻辑状态变化受物理活动/历史约束，引用检查异常必须 fail-closed。",
        "acceptance": ["活动物理阻止逻辑下线", "任何物理历史阻止逻辑作废", "checker 异常拒绝作废", "OFFLINE 不能承接新物理"],
        "priority": "must",
        "source": "用户确认",
        "counterexample": ["checker 不可用时仍作废", "作废后重新启用"]
      },
      {
        "id": "R7",
        "statement": "建议只能由用户显式采用且不得覆盖 dirty 字段；AI 只预留 provider 接口，首期不调用真实 AI 或外部网络。",
        "acceptance": ["无 AI 配置时 API 正常", "AI provider 返回空", "未点击采用时字段不变", "architecture 无 ai 依赖"],
        "priority": "must",
        "source": "用户确认",
        "counterexample": ["表单加载时自动覆写", "请求 business/ai 或外部模型"]
      },
      {
        "id": "R8",
        "statement": "权限必须按 view 包含查询、apply 包含申请、manage 包含申请和审批分层，manage 可审批本人申请。",
        "acceptance": ["本人/全部申请范围正确", "manage 同时满足工作流任务权限", "旧权限按最小能力映射", "跨租户拒绝"],
        "priority": "must",
        "source": "用户确认",
        "counterexample": ["apply 可审批", "manage 绕过流程写主表"]
      },
      {
        "id": "R9",
        "statement": "固定流程 architecture.subsystem.change 必须按新轮次启动，生命周期事件按事件、实例、轮次和摘要幂等，批准时重校验并原子发布。",
        "acceptance": ["退回重提产生新 instance/round", "重复/旧事件无副作用", "发布失败保持未批准并可重试", "取消由 TERMINATED 确认"],
        "priority": "must",
        "source": "用户确认与现有 workflow 公共契约",
        "counterexample": ["复用已 RETURN 的流程实例", "旧轮次批准覆盖新草稿"]
      },
      {
        "id": "R10",
        "statement": "必须提供独立工单列表、全页表单和业务详情；桌面展开卡片、移动纵向卡片，覆盖所有加载/权限/冲突/提交状态。",
        "acceptance": ["1280x800 与三个手机视口无页面级横滚", "业务详情可审批但不可改字段", "逻辑 0..N 物理卡片可操作", "控制台无新增错误"],
        "priority": "must",
        "source": "用户确认",
        "counterexample": ["复杂申请仍放抽屉", "手机只能横向滚动完成提交"]
      },
      {
        "id": "R11",
        "statement": "既有编号和 GET 必须兼容；旧写路径改为无副作用的 ARCHITECTURE_WORK_ORDER_REQUIRED；仅追加 V82-V84 并走公开模块契约。",
        "acceptance": ["既有 code 不变", "旧 GET 回归", "旧写 409 且数据不变", "模块边界和 Flyway 检查通过"],
        "priority": "must",
        "source": "用户批准兼容方案",
        "counterexample": ["批量重写旧 code", "architecture 直接访问 workflow 表"]
      },
      {
        "id": "R12",
        "statement": "交付必须通过单元、MockMvc、真实 MySQL/Flyway、真实工作流、Boot、治理和四视口真实浏览器验收，并形成控制收敛证据。",
        "acceptance": ["自动化命令退出码 0", "真实 instance/task 与业务发布对账", "浏览器网络/控制台/几何通过", "开放反馈为 0"],
        "priority": "must",
        "source": "原票据和仓库治理",
        "counterexample": ["用纯 Mock 代替真实工作流", "只用前端 build 声称 UAT 通过"]
      }
    ],
    "invariants": [
      "未批准申请不修改发布主记录",
      "同一发布目标最多一张 IN_REVIEW 或 RETURNED 申请",
      "已发布编号永久不可复用",
      "物理编号中的逻辑序号与发布归属一致",
      "逻辑级联创建与物理 REPLACE 原子发布",
      "作废不可逆且引用检查异常拒绝",
      "审批人和建议 provider 均不能静默修改人工业务值",
      "租户只来自认证上下文",
      "首期 AI provider 不调用真实 AI"
