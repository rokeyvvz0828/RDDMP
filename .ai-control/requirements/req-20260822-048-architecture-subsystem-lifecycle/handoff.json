    "architecture": {
      "boundary": {
        "inside": ["business/architecture Java/Vue", "V82-V84", "architecture integration contract and governance"],
        "outside": ["workflow/security/system/shared internals", "other business modules", "business/ai", "production systems"]
      },
      "components": [
        "published subsystem query and controlled repository",
        "typed change application service/store",
        "fixed-prefix incremental number strategy/store",
        "publication service and reference guard",
        "workflow lifecycle consumer and receipt store",
        "deterministic suggestion and no-op AI provider",
        "responsive master/application Vue pages"
      ],
      "interfaces": [
        "architecture subsystem REST",
        "WorkflowBusinessGateway and WorkflowLifecycleConsumer",
        "com.ccb.architecture.integration.SubsystemReferenceChecker",
        "SubsystemNumberStrategy",
        "SubsystemSuggestionProvider"
      ],
      "data_flows": [
        "draft save -> submit validation -> number/value reservation and target lock -> workflow start",
        "workflow APPROVED -> idempotent receipt -> revalidation -> atomic master publication -> history and release",
        "RETURNED -> retained lock/reservations -> edit -> new round",
        "REJECTED/CANCELLED -> history -> release unapproved reservations and locks",
        "query -> published master only; suggestion -> explicit local adoption only"
      ]
    },
    "error_handling": [
      "400 for invalid field/state/parent/capacity/reference rule",
      "401/403 for authentication/RBAC/entity/workflow task authorization",
      "404 for tenant-scoped missing entities",
      "409 for target/value/rowVersion/round conflicts and legacy writes",
      "503 for indeterminate external reference check with VOID fail-closed",
      "workflow publication failure remains retryable and does not mark application approved"
