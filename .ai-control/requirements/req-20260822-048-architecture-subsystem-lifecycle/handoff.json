      "compatibility": ["existing code unchanged", "GET paths preserved", "legacy writes return stable 409 guidance", "append-only migrations"],
      "operations": ["idempotent lifecycle receipts", "retryable publication", "forward-only rollback", "no real AI or external access"]
    },
