    "constraints": [
      "只修改 codex-task-scope.yaml 的 writable_paths",
      "不修改 V1-V81，不访问 workflow 内部实现或表",
      "不依赖业务表单元数据或 business/ai",
      "使用 Java 17、Spring Boot 3.4.4、JdbcTemplate、MySQL 8.4、Vue 3 和现有 UI 组件",
