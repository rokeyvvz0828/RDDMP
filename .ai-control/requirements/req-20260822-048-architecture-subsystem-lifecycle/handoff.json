    "selected_approach": {
      "name": "发布主记录加强类型工单加平台工作流",
      "reason": "保持稳定查询，隔离草稿与发布事实，并用数据库约束、编号策略和幂等事件形成可验证闭环。",
      "alternatives": [
        "继续直接 CRUD：缺少审批发布和历史，拒绝",
