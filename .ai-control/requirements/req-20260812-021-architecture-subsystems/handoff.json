    "objective": "在独立 business/architecture 模块内建立逻辑子系统与物理子系统的类型化、租户隔离、权限受控、关联完整且可审计的基础信息管理闭环。",
    "users": ["架构信息查看者", "架构信息维护者", "系统管理员"],
    "requirements": [
      {"id":"R1","statement":"逻辑子系统支持分页筛选、详情、新增、编辑和软删除。","acceptance":["创建后可在原筛选和页码重读","详情、编辑和软删除刷新后保持一致"],"priority":"must","source":"用户批准修订 3","counterexample":["仅静态页面","物理删除"]},
      {"id":"R2","statement":"物理子系统支持完整维护，并且每条活动记录必须关联当前租户未删除逻辑子系统。","acceptance":["逻辑一对多物理","无效父引用 400","并发父删除 409"],"priority":"must","source":"用户确认父子关系","counterexample":["无父记录","仅前端校验"]},
      {"id":"R3","statement":"两类编号由服务端转大写并校验格式，编号和名称在租户内永久唯一。","acceptance":["格式准确","重复和删除后复用 409"],"priority":"must","source":"用户确认","counterexample":["保存小写","删除后复用"]},
      {"id":"R4","statement":"所有组织、用户、参数和逻辑引用必须属于当前租户并符合保存时有效性。","acceptance":["跨租户/无效拒绝","参数白名单"],"priority":"must","source":"安全规则和用户确认","counterexample":["信任客户端","跨租户引用"]},
      {"id":"R5","statement":"被活动物理子系统引用的逻辑子系统不得删除。","acceptance":["409","父子一致","无悬挂活动引用"],"priority":"must","source":"用户确认","counterexample":["级联删除","悬挂引用"]},
      {"id":"R6","statement":"服务端按资源和动作执行八项权限、认证租户隔离和统一操作审计。","acceptance":["401/403 准确","AuthUser tenant","trace 审计"],"priority":"must","source":"用户批准审计方案 1","counterexample":["仅前端权限","客户端 tenant","审计覆盖错误"]},
      {"id":"R7","statement":"逻辑事业群、物理负责团队、人员和六类分类通过平台安全来源读取。","acceptance":["受控引用","用户分页最小字段","实时电话不落业务表"],"priority":"must","source":"用户确认","counterexample":["团队自由文本","要求 system 管理权限","泄露字段"]},
      {"id":"R8","statement":"菜单、权限、参数和虚构 Mock 自动初始化且幂等，不新增动态表单元数据。","acceptance":["空库无需手工目录","重复不新增","无 biz_form/schema"],"priority":"must","source":"用户选择固定表单和 main 退役规则","counterexample":["依赖输入项配置","新增 PublishedFormSchemaQuery"]},
      {"id":"R9","statement":"两个固定强类型页面在桌面与移动端完整呈现全部关键状态。","acceptance":["小屏卡片","三个手机视口无整页横滚","构建/控制台通过"],"priority":"must","source":"用户和项目准入","counterexample":["运行时 schema","手机整页横滚","失败无重试"]},
      {"id":"R10","statement":"V1 不实现启用、停用、状态筛选或状态变更。","acceptance":["无启停动作","软删除不等于停用"],"priority":"must","source":"用户明确要求","counterexample":["启停按钮","status 请求"]},
      {"id":"R11","statement":"领域代码、表、HTTP 和前端归独立 business/architecture。","acceptance":["ccb-architecture/Boot","前端模块","治理一致","platform 无领域类型"],"priority":"must","source":"用户明确要求","counterexample":["com.ccb.system 领域服务","平台反向依赖"]},
      {"id":"R12","statement":"tenant_id 仅由认证用户注入、页面不可见且数据库无默认；local Mock 只用经校验显式租户。","acceptance":["请求无 tenant","客户端不能覆盖","DB 无 DEFAULT","非 local 不运行"],"priority":"must","source":"用户确认方案 A","counterexample":["常量 1","页面 tenant","Mock 缺省"]},
      {"id":"R13","statement":"物理事业群为可空文本，负责团队必选组织并保存服务端名称快照，物理负责人和联系人均可空。","acceptance":["blank 到 null/100","团队必填","失效历史可读/编辑重选","人员可空"],"priority":"must","source":"用户批准修订 3","counterexample":["事业群组织 ID","客户端快照","失效不可读","负责人必填"]}
    ],
