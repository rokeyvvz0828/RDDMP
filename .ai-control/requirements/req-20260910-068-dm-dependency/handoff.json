  "design": {
    "schema_version": 1,
    "topic": "data-migration-dependency",
    "design_revision": 1,
    "design_status": "approved",
    "human_document": "docs/engineering-control/designs/2026-09-10-data-migration-dependency-design.md",
    "objective": "将迁移过程依赖文件改造为可单条维护和批量导入的迁移参数与使用方系统关系管理能力，并彻底下线文件上传下载契约。",
    "users": [
      "迁移配置维护人员在当前项目登记和调整参数使用关系",
      "批量维护人员通过两列 Excel 模板导入并处理逐行错误",
      "查询人员比较参数、提供方、使用方和更新信息",
      "管理员通过统一回收站恢复或彻底删除关系"
    ],
    "requirements": [
      {
        "id": "R1",
        "statement": "dm_dependency 增加 parameter_id，system_code 表示使用方，空表迁移删除 doc_code/doc_name。",
        "acceptance": [
          "空表应用 V199 后新列、旧列和索引符合设计",
          "非空表在任何结构修改前失败"
        ],
        "priority": "must",
        "source": "用户确认的数据模型和历史数据策略",
        "counterexample": [
          "为历史行生成默认参数 ID",
          "修改已发布迁移"
        ]
      },
      {
        "id": "R2",
        "statement": "列表展示参数中英文名、使用方编号/名称、提供方编号/名称、更新时间和更新人。",
        "acceptance": [
          "列表数据由当前项目关系和参数、系统投影得到",
          "桌面与移动列表均可观察全部信息"
        ],
        "priority": "must",
        "source": "用户列表需求及字段映射确认",
        "counterexample": [
          "提供方名称显示系统编号",
          "名称冗余写入 dm_dependency"
        ]
      },
      {
        "id": "R3",
        "statement": "提供单条新增、编辑和逻辑删除，并保证租户、项目、参数与使用方关系唯一。",
        "acceptance": [
          "有效关系可新增和编辑",
          "重复、跨项目、无效参数或停用系统被服务端拒绝"
        ],
        "priority": "must",
        "source": "用户确认的操作范围和唯一规则",
        "counterexample": [
          "仅前端判重",
          "更新允许改变所属项目"
        ]
      },
      {
        "id": "R4",
        "statement": "Excel 模板使用参数英文名和使用方系统编号，逐行校验并允许部分成功。",
        "acceptance": [
          "模板仅有两列",
          "零命中、多义、无效系统和重复行报告实际行号",
          "合法行继续写入并审计"
        ],
        "priority": "must",
        "source": "用户确认的导入模板和歧义处理",
        "counterexample": [
          "模板暴露参数 ID",
          "多义时任取参数",
          "一行错误回滚所有合法行"
        ]
      },
      {
        "id": "R5",
        "statement": "取消依赖文件上传、替换和下载，DEPENDENCY 从通用附件服务与回收站来源剥离。",
        "acceptance": [
          "页面无文件操作",
          "旧上传替换下载端点不可用",
          "专属回收站来源承接 DEPENDENCY"
        ],
        "priority": "must",
        "source": "用户删除文件上传功能的要求和方案 A 确认",
        "counterexample": [
          "隐藏按钮但保留可调用上传端点"
        ]
      },
      {
        "id": "R6",
        "statement": "菜单 750 使用查看、新增、编辑、删除细粒度权限，所有写操作执行项目/实体授权和审计。",
        "acceptance": [
          "V199 补充权限节点",
          "无权限请求返回 403",
          "写操作产生 DEPENDENCY 审计"
        ],
        "priority": "must",
        "source": "用户确认的权限设计与仓库治理",
        "counterexample": [
          "硬编码角色",
          "仅依赖前端按钮显隐"
        ]
      },
      {
        "id": "R7",
        "statement": "依赖关系接入统一回收站并保护参数引用完整性。",
        "acceptance": [
          "管理员可恢复和彻底删除",
          "活动依赖阻止参数逻辑删除",
          "任意依赖阻止参数彻底删除"
        ],
        "priority": "must",
        "source": "用户确认的回收站范围和工程数据完整性约束",
        "counterexample": [
          "删除参数后活动列表无法显示参数名称"
        ]
      },
      {
        "id": "R8",
        "statement": "看板 DEPENDENCY 指标适配新结构，前端覆盖完整状态与桌面/移动验收。",
        "acceptance": [
          "看板计数和下钻不引用旧列",
          "页面覆盖加载空失败无权限和提交中",
          "三个手机视口无页面级横向溢出"
        ],
        "priority": "must",
        "source": "现有看板引用事实与 RDDMP 前端规约",
        "counterexample": [
          "V199 后看板 SQL 因 doc_code 不存在而失败",
          "手机仅展示被裁剪桌面表格"
        ]
      }
    ],
    "invariants": [
      "数据 Owner 和菜单路由不变",
      "提供方编号来自 dm_parameter.system_code，使用方编号来自 dm_dependency.system_code",
      "系统名称只读投影，不在依赖表冗余",
      "不改变迁移参数英文名唯一范围",
      "只追加 V199，不修改已发布迁移",
      "不读取或写入生产数据、真实附件和密钥"
    ],
    "constraints": [
      "Java 17、Spring Boot 3.4.4、MySQL 8.4、Vue 3",
      "只能修改 REQ-20260910-068 任务范围授权路径",
      "当前工作区存在 REQ-20260906-067 用户改动，必须保护",
      "V199 和新应用必须同批发布"
    ],
    "non_goals": [
      "依赖关系导出",
      "迁移参数或系统组件清单改造",
      "历史依赖数据迁移",
      "公共 UI 组件或主题变更",
      "删除 component_id 兼容列"
    ],
    "selected_approach": {
      "name": "方案 A：DEPENDENCY 专属领域服务和页面",
      "reason": "彻底隔离参数关系与附件生命周期，并复用参数和检核规则已验证的域化范式。",
      "alternatives": [
        {
          "name": "通用文件服务内分支",
          "rejected_because": "关系、Excel 与附件职责混杂且容易残留上传入口"
        },
        {
          "name": "新建并行关系表",
          "rejected_because": "违背改造 dm_dependency 的明确要求并产生双数据源"
        }
      ]
    },
    "architecture": {
      "boundary": {
        "inside": [
          "business/data-migration 依赖领域",
          "V199 Flyway 迁移",
          "依赖页面和前端 API",
          "菜单 750 权限节点",
          "统一回收站来源",
          "DEPENDENCY 看板适配"
        ],
        "outside": [
          "平台附件实现",
          "系统/组件清单维护",
          "迁移参数字段和唯一规则",
          "其他内容菜单"
        ]
      },
      "components": [
        {
          "name": "DependencyService",
          "responsibility": "关系 CRUD、投影、导入、审计和回收站",
          "depends_on": [
            "JdbcTemplate",
            "DataMigrationPermissionService",
            "UserDirectoryPort"
          ]
        },
        {
          "name": "DependencyController",
          "responsibility": "专属 REST 和 RBAC",
          "depends_on": [
            "DependencyService"
          ]
        },
        {
          "name": "DependencyRecycleBinSource",
          "responsibility": "注册 DEPENDENCY 回收站能力",
          "depends_on": [
            "DependencyService"
          ]
        },
        {
          "name": "V199",
          "responsibility": "空表门禁、结构和权限迁移",
          "depends_on": [
            "V198 后数据库结构"
          ]
        },
        {
          "name": "DependenciesPage",
          "responsibility": "桌面/移动查询维护和导入体验",
          "depends_on": [
            "data-migration API",
            "现有 Ui 组件"
          ]
        }
      ],
      "interfaces": [
        {
          "name": "/api/data-migration/dependencies",
          "producer": "DependencyController",
          "consumers": [
            "DependenciesPage"
          ],
          "contract": "分页、详情、CRUD、模板和逐行导入"
        },
        {
          "name": "/api/data-migration/components/options/systems",
          "producer": "ProjectComponentService",
          "consumers": [
            "DependenciesPage"
          ],
          "contract": "当前项目启用系统选项"
        },
        {
          "name": "RecycleBinSource:DEPENDENCY",
          "producer": "DependencyRecycleBinSource",
          "consumers": [
            "ContentRecycleBinService"
          ],
          "contract": "计数、列表、详情、恢复、彻底删除"
        }
      ],
      "data_flows": [
        {
          "input": "parameterId + consumerSystemCode",
          "transitions": [
            "校验权限和项目",
            "校验参数与系统",
            "判重",
            "写 dm_dependency",
            "写审计"
          ],
          "output": "关联投影记录"
        },
        {
          "input": "两列 xlsx",
          "transitions": [
            "文件门禁",
            "逐行解析英文名",
            "校验系统和重复",
            "合法行写入并审计"
          ],
          "output": "rows/accepted/failed/errors"
        }
      ]
    },
    "error_handling": [
      {
        "condition": "V199 前表非空",
        "behavior": "迁移在改结构前失败",
        "recovery": "停止发布并由需求负责人另行决定历史数据策略"
      },
      {
        "condition": "参数英文名零命中或多义",
        "behavior": "导入该行失败且不任取",
        "recovery": "修正模板或先治理参数数据"
      },
      {
        "condition": "关系重复",
        "behavior": "单条请求 409，导入行失败",
        "recovery": "编辑或恢复既有关系"
      },
      {
        "condition": "参数或使用方失效",
        "behavior": "新增编辑或恢复被拒绝",
        "recovery": "选择活动参数和启用系统"
      },
      {
        "condition": "无权限或跨项目",
        "behavior": "403 或范围错误且不写数据",
        "recovery": "申请权限或切换正确项目"
      }
    ],
    "quality_attributes": {
