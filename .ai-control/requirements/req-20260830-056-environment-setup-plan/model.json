    {"requirement": "执行与豁免", "input": "开始/完成/重开/取消/恢复动作", "transitions": ["实体授权校验", "写事件", "重算任务状态与进度", "向上传播阶段/计划状态"], "outputs": ["计算状态+进度+豁免标识"]},
    {"requirement": "依赖阻塞", "input": "依赖建立/移除、阻塞登记/解除", "transitions": ["循环校验", "重算等待前置/阻塞状态并聚合"], "outputs": ["任务状态+聚合标识"]},
    {"requirement": "时间逾期", "input": "计划时间维护/调整、执行事件、事件更正", "transitions": ["聚合实际时间", "按 now 计算逾期并聚合"], "outputs": ["实际时间+逾期标识"]},
    {"requirement": "调整与工单", "input": "新增/移出目标、新增结构、工单关联/解除", "transitions": ["校验状态与权限", "自动取消未完成任务", "重算", "未结束工单阻止完成"], "outputs": ["调整后结构+门禁"]},
    {"requirement": "通知", "input": "分派/阻塞/临期/逾期/关键状态变更/工单结束", "transitions": ["构造 NotificationPublishCommand", "try/catch 发布"], "outputs": ["站内通知；失败只记日志"]}
