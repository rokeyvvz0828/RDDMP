    "objective": "项目详情支持持久附件上传、列表、在线预览、下载和受控删除",
    "users": ["项目成员查看和下载附件", "项目负责人或项目更新权限用户维护附件", "超级管理员管理所有项目附件"],
    "requirements": [
      {"id": "R1", "statement": "项目详情显示项目附件页签并提供明确加载/空/失败状态", "acceptance": ["项目成员进入项目详情可以打开附件页签"], "priority": "must", "source": "用户确认的设计", "counterexample": ["只添加上传按钮但没有项目上下文"]},
      {"id": "R2", "statement": "附件持久保存并绑定项目", "acceptance": ["上传后刷新页面仍可看到文件元数据"], "priority": "must", "source": "用户确认的设计", "counterexample": ["仅存为临时预览文件"]},
      {"id": "R3", "statement": "附件支持kkFileView在线预览和短时下载", "acceptance": ["预览和下载地址由服务端按需生成"], "priority": "must", "source": "用户确认的设计", "counterexample": ["前端拼接MinIO或外部URL"]},
      {"id": "R4", "statement": "附件遵循项目成员、负责人和超级管理员权限", "acceptance": ["非成员跨项目和跨租户请求被拒绝"], "priority": "must", "source": "现有项目权限规则", "counterexample": ["仅依靠前端隐藏按钮"]},
      {"id": "R5", "statement": "迁移、测试、构建和浏览器验收通过", "acceptance": ["V45追加、后端测试、前端构建和桌面/移动验收有证据"], "priority": "must", "source": "仓库交付规约", "counterexample": ["修改已发布迁移"]}
    ],
    "invariants": ["tenant_id + business_type + business_id三层范围", "对象键只在服务端", "V45追加且历史迁移不变", "临时file-preview语义不变"],
    "constraints": ["保持com.ccb包名", "业务模块只能依赖公开AttachmentPort", "前端复用UiFilePreview", "项目权限在ProjectService服务端校验"],
    "non_goals": ["版本管理", "全文检索", "分片上传", "外部分享", "匿名上传"],
    "selected_approach": {"name": "独立持久附件平台 + 项目详情适配", "reason": "为后续业务复用附件生命周期，避免项目模块直接管理对象键", "alternatives": [{"name": "项目模块直接保存MinIO对象", "rejected_because": "重复建设且违反后续公共附件能力边界"}, {"name": "复用临时file-preview", "rejected_because": "无法持久绑定、授权和生命周期管理"}]},
    "architecture": {"boundary": {"inside": ["ccb-attachment元数据和MinIO对象", "ccb-system项目权限和业务绑定", "ProjectView附件页签"], "outside": ["附件版本管理", "外部分享", "临时file-preview生命周期"]}, "components": [{"name": "AttachmentService", "responsibility": "附件对象、元数据和短时链接"}, {"name": "ProjectService", "responsibility": "项目访问和附件业务授权"}, {"name": "ProjectView", "responsibility": "附件列表、上传和预览交互"}], "interfaces": [{"name": "AttachmentPort", "producer": "ccb-attachment", "consumer": "ccb-system", "contract": "上传绑定、列表、预览、下载和删除，不暴露对象键"}], "data_flows": [{"input": "项目成员选择文件", "transitions": ["项目权限校验", "MinIO写入", "V45元数据写入", "刷新附件列表"], "output": "已绑定项目附件"}]},
    "error_handling": [{"condition": "项目不可见或附件跨租户", "behavior": "服务端拒绝", "recovery": "前端保留当前页并显示中文错误"}, {"condition": "对象写入或预览失败", "behavior": "返回失败且避免暴露对象键", "recovery": "允许重试或继续使用列表"}],
    "quality_attributes": {"security": ["认证、租户、项目成员和负责人校验"], "performance": ["按项目索引查询元数据，短时地址按需生成"], "compatibility": ["追加V45，不改变旧file-preview"], "operations": ["审计上传、预览、下载、删除，保留失败清理状态"]},
