    "objective": "Make project business permissions follow the selected project and its project roles while keeping system administration permissions global.",
    "users": ["System administrators", "Project owners", "Project members"],
    "requirements": [
      {"id": "R1", "statement": "System settings must maintain the permission catalog instead of assigning business permissions to system roles.", "acceptance": ["Authorized administrators can manage permission definitions", "Permission codes are immutable and referenced permissions cannot be deleted"], "priority": "must", "source": "User-confirmed design", "counterexample": ["System settings still assigns business permissions directly to system roles"]},
      {"id": "R2", "statement": "Project roles must configure project business permissions from the central catalog.", "acceptance": ["Project role permissions persist", "System permissions are excluded"], "priority": "must", "source": "User-confirmed design", "counterexample": ["A project role grants system administration access"]},
      {"id": "R3", "statement": "Effective business permissions must change with the active project and be enforced by the server.", "acceptance": ["Projects A and B produce their configured permission sets", "Menus, routes, buttons and APIs agree", "Forged context is rejected"], "priority": "must", "source": "User-confirmed design", "counterexample": ["Only frontend visibility changes"]},
      {"id": "R4", "statement": "Existing roles must be initialized without project administration lockout.", "acceptance": ["PM gets all business permissions", "Other existing roles get read permissions", "New roles get none", "Owner has full fallback"], "priority": "must", "source": "User-confirmed migration decision", "counterexample": ["A project owner cannot configure roles after migration"]},
      {"id": "R5", "statement": "Permission changes must preserve tenant/project isolation and be audited.", "acceptance": ["Cross-project and cross-tenant identifiers are rejected", "Writes create audit records"], "priority": "must", "source": "Repository security rules", "counterexample": ["A role from project A is changed through project B"]}
