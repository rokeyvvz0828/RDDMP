    "invariants": ["System administration permissions remain global", "Project roles cannot grant system permissions", "Backend authorization is authoritative", "Flyway is append-only"],
    "constraints": ["Keep existing packages and JWT format", "Reuse sys_menu_permission", "Use X-Project-Id", "No production access"],
    "non_goals": ["Organization/member redesign", "JWT permission claims", "Business form metadata"],
    "selected_approach": {"name": "Request-scoped project context with server-side permission union", "reason": "Immediate secure switching without token churn", "alternatives": [{"name": "Token reissue", "rejected_because": "Multi-tab and rotation complexity"}, {"name": "Frontend-only permissions", "rejected_because": "No backend enforcement"}]},
    "architecture": {
