        {"name": "Project role permission API", "producer": "platform/system", "consumers": ["Project settings"], "contract": "Read and transactionally replace permissions for a role in the path project"},
        {"name": "Effective authorization", "producer": "platform/security", "consumers": ["JWT filter", "Auth UI", "Routes"], "contract": "Global system plus active-project business permissions after scope validation"}
