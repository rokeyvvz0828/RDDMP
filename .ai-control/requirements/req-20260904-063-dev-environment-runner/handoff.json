    "objective": "通过跨平台薄入口和无第三方依赖的 Node.js 编排器，一键启动固定、可热重载且自动执行 Flyway 的 RDDMP 本地开发环境。",
    "users": ["Windows PowerShell 研发人员", "macOS/Linux Bash 研发人员"],
    "requirements": [
      {
        "id": "R1",
        "statement": "Windows 与 macOS/Linux 入口复用同一 Node.js 标准库编排器并保持行为一致。",
        "acceptance": ["wrapper 透传参数和退出码", "编排器无第三方 npm 依赖", "工具缺失时启动前失败"],
        "priority": "must",
        "source": "用户确认跨平台和 Node 编排方案",
        "counterexample": ["两套完整且漂移的脚本实现"]
      },
      {
        "id": "R2",
        "statement": "启动器固定且隔离本地开发环境，并提供 admin/admin123。",
        "acceptance": ["固定 local profile", "不覆盖用户 .env", "空库和已有库均可登录", "不接受远程地址"],
        "priority": "must",
        "source": "用户确认固定账号和确定环境",
        "counterexample": ["依赖手工 .env", "密码只在首次建库有效"]
      },
      {
        "id": "R3",
        "statement": "编排本地基础设施并由 Spring Boot 自动执行 Flyway。",
        "acceptance": ["基础设施就绪后启动后端", "Flyway 成功", "健康检查 UP", "不修改历史迁移"],
        "priority": "must",
        "source": "用户要求支持 Flyway",
        "counterexample": ["执行 Flyway clean 或修改历史迁移"]
      },
      {
        "id": "R4",
        "statement": "支持 Vite HMR 和后端源码自动编译重启。",
        "acceptance": ["Vite HMR", "后端防抖串行编译", "DevTools 重启", "编译失败可恢复"],
        "priority": "must",
        "source": "用户要求前后端热重载",
        "counterexample": ["后端必须手工重启"]
      },
      {
        "id": "R5",
        "statement": "可预测地管理日志、退出、容器停止和研发提示。",
        "acceptance": ["日志分组", "Ctrl+C 清理应用", "默认保留基础设施", "--down 不删卷", "AGENTS 提示"],
        "priority": "must",
        "source": "用户批准设计",
        "counterexample": ["遗留进程或默认删除卷"]
      }
    ],
    "invariants": ["不连接生产或共享环境", "不修改历史迁移", "不删除卷", "不覆盖用户 .env", "不越过任务范围"],
