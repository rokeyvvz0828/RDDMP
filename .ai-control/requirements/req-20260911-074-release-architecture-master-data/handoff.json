    "objective": "配置管理版本申请使用当前项目的架构物理子系统和交付单元真实主数据，并由服务端保存可信快照。",
    "users": ["版本申请人", "配置管理人员", "技术架构师", "审批人员"],
    "requirements": [
      {"id":"R1","statement":"架构交付单元制品类型统一为 IMAGE/BINARY，存量旧类型按确认规则迁移。","acceptance":["新增维护只使用 IMAGE/BINARY","存量值映射正确"],"priority":"must","source":"用户确认","counterexample":["配置管理保留二次映射"]},
      {"id":"R2","statement":"架构公开项目隔离的 ACTIVE 物理子系统和交付单元最小查询。","acceptance":["跨项目无泄漏","状态和父子过滤正确"],"priority":"must","source":"用户确认设计","counterexample":["配置直接读 arch 表"]},
      {"id":"R3","statement":"配置管理使用自身权限提供项目化选择 API。","acceptance":["配置用户可查","无项目权限被拒"],"priority":"must","source":"用户确认设计","counterexample":["要求架构维护权限"]},
      {"id":"R4","statement":"申请保存前服务端规范化可信快照并拒绝失效引用。","acceptance":["伪造快照被覆盖","错项目错父子失败无副作用"],"priority":"must","source":"用户确认设计","counterexample":["信任客户端名称和类型"]},
      {"id":"R5","statement":"申请抽屉移除 Mock 并实现异步联动和全状态。","acceptance":["无 Mock 引用","切换清空且防乱序"],"priority":"must","source":"用户原始需求","counterexample":["旧项目选项残留"]},
      {"id":"R6","statement":"历史快照不变，失效草稿反显但必须重新选择。","acceptance":["只读历史不变","失效草稿不可保存"],"priority":"must","source":"用户确认","counterexample":["重写审批历史"]},
      {"id":"R7","statement":"自动化与浏览器验证覆盖安全、回归和移动端。","acceptance":["目标门禁通过","四视口可用"],"priority":"must","source":"仓库规范","counterexample":["只做静态检查"]}
    ],
    "invariants": ["架构是主数据 Owner", "配置不读架构私有表", "写入按租户项目状态父子关系校验", "历史快照不可回写"],
    "constraints": ["只追加 V213", "保持申请 DTO 兼容", "遵循模块治理和 H5 规范"],
    "non_goals": ["调整审批、窗口、文件介质和投产逻辑", "授予架构维护权限", "迁移历史申请快照"],
    "selected_approach": {"name":"消费者端口 + Boot 适配器","reason":"保持模块和权限边界并支持服务端校验","alternatives":["前端直连架构 API","配置直接依赖架构实现"]},
