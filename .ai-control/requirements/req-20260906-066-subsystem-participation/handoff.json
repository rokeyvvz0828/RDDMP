  "design": {
    "schema_version": 1,
    "topic": "subsystem-participation",
    "design_revision": 2,
    "design_status": "approved",
    "human_document": "docs/requirements/REQ-20260906-066-subsystem-participation/design.md",
    "objective": "系统参与资格与任务分工统一控制执行、个人看板和资源申请，管理者能监督但不能越权执行。",
    "users": [
      "系统负责人",
      "任务负责人和参与人",
      "计划及项目管理者",
      "资源申请人",
      "审批和办理人"
    ],
    "requirements": [
      {
        "id": "R1",
        "statement": "物理子系统维护显式参与人，有效参与人包含当前负责人；部署单元继承系统资格。",
        "acceptance": [
          "负责人不可被单独移除；不同项目同名系统不共享权限。"
        ],
        "priority": "must",
        "source": "2026-09-06当前会话确认",
        "counterexample": [
          "加入系统A却获得系统B或其他项目权限。"
        ]
      },
      {
        "id": "R2",
        "statement": "按系统或部署单元展开任务，默认负责人为系统负责人，默认参与人为系统有效参与人；任务创建前后均可独立调整。",
        "acceptance": [
          "新负责人自动加入任务；旧负责人默认保留为参与人；任务负责人必填且不可单独移除。"
        ],
        "priority": "must",
        "source": "2026-09-06当前会话确认",
        "counterexample": [
          "修改一个任务反向修改系统名单或其他任务。"
        ]
      },
      {
        "id": "R3",
        "statement": "人员默认值采用创建时快照，系统资格执行实时校验。",
        "acceptance": [
          "新增系统成员不自动加入旧任务；移除成员立即失去资格；未完任务负责人和未解决阻塞负责人先移交。"
        ],
        "priority": "must",
        "source": "2026-09-06当前会话确认",
        "counterexample": [
          "旧页面或旧任务名单可以绕过人员移除。"
        ]
      },
      {
        "id": "R4",
        "statement": "普通人员只看本人任务及检查项；管理者可查看授权项目或计划全貌，但不得越权执行。",
        "acceptance": [
          "非任务人员即使是管理员，也不能启动任务、完成或重新打开检查项。"
        ],
        "priority": "must",
        "source": "2026-09-06当前会话确认",
        "counterexample": [
          "通过管理员放行分支代勾检查项。"
        ]
      },
      {
        "id": "R5",
        "statement": "敏捷看板直接替换环境搭建计划详情中原有的看板页签，只展示当前计划任务，按未开始、已开始、已完成、阻塞分列；默认只展示本人相关任务，管理者可切换查看当前计划全部任务，但不得越权执行。",
        "acceptance": [
          "WAITING_PRECEDING映射阻塞；取消默认隐藏；计数与分页仅统计可见任务；不能拖动绕过检查项。"
        ],
        "priority": "must",
        "source": "2026-09-06当前会话确认",
        "counterexample": [
          "看板只在前端过滤，接口返回全部任务。"
        ]
      },
      {
        "id": "R6",
        "statement": "资源申请只能选择、申请本人参与系统的部署单元，保留申请人和流程职责限制。",
        "acceptance": [
          "创建、编辑、复制、提交、任务发起、批量明细逐一校验；办理和审批按流程授权。"
        ],
        "priority": "must",
        "source": "2026-09-06当前会话确认",
        "counterexample": [
          "替换部署单元ID或提交移除成员前保存的草稿成功。"
        ]
      },
      {
        "id": "R7",
        "statement": "同一业务对象的选项、详情、报告、附件、通知、关联工单和批量入口采用一致授权。",
        "acceptance": [
          "不可见前置任务只展示条件未满足；管理员管理视图不扩大资源申请权限；附件下载不能绕过对象权限。"
        ],
        "priority": "must",
        "source": "2026-09-06当前会话确认",
        "counterexample": [
          "通过搜索总数、报告或附件读取不可见任务。"
        ]
      },
      {
        "id": "R8",
        "statement": "存量兼容、审计、性能及桌面移动端验收必须覆盖。",
        "acceptance": [
          "保留历史任务分工，资格不符进入待处理且拒绝执行；完成四种视口与明暗主题验收。"
        ],
        "priority": "must",
        "source": "2026-09-06当前会话确认",
        "counterexample": [
          "批量补全所有任务人员造成权限扩大，或修改已发布迁移。"
        ]
      }
    ],
    "invariants": [
      "系统负责人默认参与系统，任务负责人默认参与任务。",
      "管理可见性不授予执行资格。",
      "任务名单为独立快照，系统资格实时校验。"
    ],
    "constraints": [
      "保留现有Java包和模块边界",
      "本轮只写文档",
      "数据库只追加迁移",
      "前后端共同权限控制"
    ],
    "non_goals": [
      "跨计划或跨项目聚合看板",
      "新建任务体系",
      "修改其他业务模块",
      "引入动态表单"
    ],
    "selected_approach": {
      "name": "默认带入、任务独立维护、资格实时校验",
      "reason": "满足系统默认分工与任务后续调整，同时避免历史名单残留越权",
      "alternatives": [
        {
          "name": "系统内全员执行全部任务",
          "rejected_because": "不能表达任务分工"
        },
        {
          "name": "持续全量同步",
          "rejected_because": "覆盖独立分工并扩大权限"
        }
      ]
    },
    "architecture": {
      "boundary": {
        "inside": [
          "架构模块参与关系、任务执行和查询、资源申请、看板及关联入口"
        ],
        "outside": [
          "平台用户/权限实现",
          "其他业务模块"
        ]
      },
      "components": [
        {
          "name": "参与资格",
          "responsibility": "系统有效成员及实时校验",
          "depends_on": []
        },
        {
          "name": "任务分工",
          "responsibility": "生成默认值及独立更新",
          "depends_on": [
            "参与资格"
          ]
        },
        {
          "name": "查询执行",
          "responsibility": "个人范围、管理范围和执行权限",
          "depends_on": [
            "任务分工"
          ]
        },
        {
          "name": "资源申请",
          "responsibility": "目标系统和申请人校验",
          "depends_on": [
            "参与资格"
          ]
        },
        {
          "name": "敏捷看板",
          "responsibility": "四列个人任务和管理入口",
          "depends_on": [
            "查询执行"
          ]
        }
      ],
      "interfaces": [
        {
          "name": "统一系统参与资格",
          "producer": "参与资格",
          "consumers": [
            "任务分工",
            "查询执行",
            "资源申请"
          ],
          "contract": "T1冻结候选requireSystemParticipant与ParticipationView，租户/项目隔离"
        }
      ],
      "data_flows": [
        {
          "input": "系统负责人及显式成员",
          "transitions": [
            "生成任务默认值",
            "任务级调整",
            "实时校验系统资格"
          ],
          "output": "个人可见任务和合法执行动作"
        }
      ]
    },
    "error_handling": [
      {
        "condition": "无资格",
        "behavior": "不可见对象不存在；可见对象动作禁止",
        "recovery": "合法分派或人员维护后重试"
      },
      {
        "condition": "版本冲突",
        "behavior": "拒绝覆盖并提示刷新",
        "recovery": "刷新后重新提交"
      }
    ],
    "quality_attributes": {
      "security": [
        "查询和写入同一实体范围，管理员不豁免执行"
      ],
      "performance": [
        "批量成员查询，分页前过滤"
      ],
      "compatibility": [
        "保留旧任务名单和历史审计"
      ],
      "operations": [
        "追加迁移，异常负责人先移交"
      ]
    },
    "verification_strategy": [
      {
        "requirement_ids": [
          "R1",
          "R3",
          "R8"
        ],
        "signal": [
          "同项目系统A/B成员严格隔离；有效集合去重且含负责人。",
          "系统负责人退出或用户停用后实时失效；退出前阻塞未完责任移交；成员版本冲突不覆盖他人修改。"
        ],
        "method": "T1聚焦测试与集成验收"
      },
      {
        "requirement_ids": [
          "R2",
          "R3",
          "R8"
        ],
        "signal": [
          "系统A负责人甲、成员乙丙展开后默认甲负责、甲乙丙参与；单任务改乙负责只影响该任务。",
          "按部署单元取其所属系统；无负责人不能提交；新系统成员不进入旧任务；修改系统负责人不重写任务。",
          "更换任务负责人后旧人保留参与；公共任务按项目资格校验，不依赖虚构系统。"
        ],
        "method": "T2聚焦测试与集成验收"
      },
      {
        "requirement_ids": [
          "R3",
          "R4",
          "R7"
        ],
        "signal": [
          "仅系统成员但非任务人员不能执行；管理者能查看授权计划全部任务但启动/勾选/重开返回禁止。",
          "个人列表、详情、报告、时间视图、分页总数仅含合法本人任务；不可见前置任务不返回详情。",
          "任务参与人被移除后，重放旧完成请求失败；取消/恢复仍保留原管理职责与审计。"
        ],
        "method": "T3聚焦测试与集成验收"
      },
      {
        "requirement_ids": [
          "R6",
          "R7"
        ],
        "signal": [
          "申请人参与A不参与B，混合A/B部署单元申请整体拒绝；创建、复制、编辑、提交均拒绝替换目标ID。",
          "被移除人员的草稿不能提交；审批人/办理人未参与系统仍能履行已分配流程动作。",
          "源系统参与人可以申请合法目录目标网络访问，不需要加入目标系统；非法目标和不可见工单关联拒绝。",
          "资源、附件、通知跳转、搜索与导出按对象范围校验，既有平台能力不足时停止该接入而非修改平台绕过。"
        ],
        "method": "T4聚焦测试与集成验收"
      },
      {
        "requirement_ids": [
          "R2",
          "R4",
          "R5",
          "R8"
        ],
        "signal": [
          "NOT_STARTED/IN_PROGRESS/COMPLETED/BLOCKED与WAITING_PRECEDING准确分列，取消默认隐藏，计数与实际本人卡片一致。",
          "看板默认仅展示当前计划本人相关任务；管理者可在同一看板切换当前计划全部任务，无执行资格不显示执行操作；其他计划任务不得混入。",
          "切项目晚到响应不得覆盖新项目；375/390/430宽无整页横溢；明暗主题、提交失败和无权限有明确反馈。"
        ],
        "method": "T5聚焦测试与集成验收"
      },
      {
        "requirement_ids": [
          "R1",
          "R2",
          "R3",
          "R4",
          "R5",
          "R6",
          "R7",
          "R8"
        ],
        "signal": [
          "新建数据库与升级数据库均满足关系唯一约束；旧任务名单未批量扩大；异常负责人被识别且不能执行。",
          "两个项目、两系统、管理员、任务成员、仅系统成员、退出成员、审批/办理人全矩阵通过。",
          "完整测试、生产构建和全部指定视口实测记录；未执行部分不写通过。"
        ],
        "method": "T6聚焦测试与集成验收"
      }
    ],
