{
  "baseline_revision": "baseline-1",
  "plant_boundary": {
    "inside": [
      "architecture物理系统及arch_plan任务/检查项/阻塞",
      "资源申请与关联对象、业务附件策略",
      "现有PhysicalSubsystemPage与PlanDetailPage dashboard页签"
    ],
    "environment": [
      "ProjectMemberReferenceQuery/SystemReferenceQuery公开能力",
      "MySQL8.4与Flyway",
      "Vue和Maven测试运行器"
    ]
  },
  "state_variables": [
    {
      "name": "系统有效参与集合",
      "owner": "SubsystemParticipationService",
      "valid_values": [
        "负责人和显式成员与有效项目成员交集"
      ]
    },
    {
      "name": "任务状态",
      "owner": "PlanEngine",
      "valid_values": [
        "NOT_STARTED",
        "WAITING_PRECEDING",
        "IN_PROGRESS",
        "BLOCKED",
        "COMPLETED",
        "CANCELLED"
      ]
    }
  ],
  "causal_paths": [
    {
      "requirement_id": "R1",
      "input": "系统人员更新",
      "transitions": [
        "项目成员与系统负责人校验",
        "父行锁",
        "名单写入"
      ],
      "outputs": [
        "有效名单含负责人"
      ]
    },
    {
      "requirement_id": "R2",
      "input": "展开计划任务",
      "transitions": [
        "解析目标系统",
        "复制默认分工",
        "逐任务调整"
      ],
      "outputs": [
        "任务负责人及参与人快照"
      ]
    },
    {
      "requirement_id": "R3",
      "input": "成员撤销后执行",
      "transitions": [
        "实时项目/系统资格校验及未完责任检查"
      ],
      "outputs": [
        "撤销后旧名单不再授权"
      ]
    },
    {
      "requirement_id": "R4",
      "input": "查询或执行任务",
      "transitions": [
        "区分管理范围与执行资格"
      ],
      "outputs": [
        "个人过滤、管理员无执行豁免"
      ]
    },
    {
      "requirement_id": "R5",
      "input": "当前计划看板请求",
      "transitions": [
        "服务端按可见任务过滤并分类"
      ],
      "outputs": [
        "四列和授权计数"
      ]
    },
    {
      "requirement_id": "R6",
      "input": "申请部署单元资源",
      "transitions": [
        "逐明细解析系统并校验参与资格"
      ],
      "outputs": [
        "非参与系统申请拒绝"
      ]
    },
    {
      "requirement_id": "R7",
      "input": "关联对象/附件请求",
      "transitions": [
        "复用业务实体授权策略"
      ],
      "outputs": [
        "旁路读取及执行拒绝"
      ]
    },
    {
      "requirement_id": "R8",
      "input": "迁移或不同视口访问",
      "transitions": [
        "保留存量任务",
        "收紧授权",
        "响应式重排"
      ],
      "outputs": [
        "无名单扩张、操作可达"
      ]
    }
  ],
  "interfaces": [
    {
      "name": "ProjectMemberReferenceQuery",
      "producers": [
        "platform/system"
      ],
      "consumers": [
        "architecture资格服务"
      ],
      "invariant": "使用公开契约，成员ID与userId不可混淆"
    },
    {
      "name": "任务执行入口",
      "producers": [
        "PlanController"
      ],
      "consumers": [
        "PlanEngine"
      ],
      "invariant": "当前代码存在管理员执行豁免，必须移除且实时检查系统资格"
    }
  ],
