  "design": {
    "schema_version": 1,
    "topic": "data-migration-asset-chain-retirement",
    "design_revision": 1,
    "design_status": "approved",
    "human_document": "docs/engineering-control/designs/2026-09-11-data-migration-asset-chain-retirement-design.md",
    "objective": "彻底下线数据迁移模块内已无调用方的通用文件/结构化资产链路（后端服务与控制器、通用 Excel 辅助、前端通用组件与 API），保留平台附件能力、看板计数登记与全部专属服务。",
    "users": [
      "数据迁移开发与运维人员（死代码减少，契约面收敛）",
      "后续新增内容类型的开发人员（只能建专属 Controller/Source）"
    ],
    "requirements": [
      {
        "id": "R1",
        "statement": "删除通用文件资产链路后端残留：StructuredAssetService、StructuredAssetController、通用 ExcelService、ContentAssetController 四个文件，以及 ContentFileAssetService 的通用 CRUD/回收站方法。",
        "acceptance": [
          "全仓 rg 扫描对上述类型与方法零引用",
          "mvn -pl :ccb-data-migration -am test 全量通过"
        ],
        "priority": "must",
        "source": "用户指令：彻底下线文件资产通用链路",
        "counterexample": [
          "仍存在对已删除类的 import 或调用"
        ]
      },
      {
        "id": "R2",
        "statement": "ContentFileAssetService 精简为仅保留 BUSINESS_TYPE、resolveAttachment、replaceMainFile 及所需依赖，删除 MANAGED_TYPES/MAX_FILE_SIZE/docCodes/userDirectory/permissions 等通用链路成员。",
        "acceptance": [
          "ContentFileAssetService 源码不含 MANAGED_TYPES 与 list/create/replace/delete 等通用方法签名",
          "ReportService 对 replaceMainFile、Plan/Topic/Mapping/Program/ReleaseDrill 对 resolveAttachment 的调用编译通过"
        ],
        "priority": "must",
        "source": "全仓调用方核验（REQ-068 收尾分析）",
        "counterexample": [
          "删除了仍在使用的 resolveAttachment/replaceMainFile"
        ]
      },
      {
        "id": "R3",
        "statement": "ContentDocCodeGenerator 前缀收敛为在用 6 类型（PLAN/MAPPING_DOC/SCRIPT/TOPIC/RELEASE_DRILL/REPORT），删除 DEPENDENCY 与 PARAMETER 条目；ContentRecycleBinService 过期类注释更正。",
        "acceptance": [
          "ContentDocCodeGeneratorTest 前缀表为 6 项且对 DEPENDENCY/PARAMETER 抛异常",
          "ContentRecycleBinService 注释不再提及已删除的通用来源"
        ],
        "priority": "must",
        "source": "调用方核验：DEPENDENCY/PARAMETER 无任何 generate 调用方",
        "counterexample": [
          "仍有服务以 DEPENDENCY/PARAMETER 调用 generate"
        ]
      },
      {
        "id": "R4",
        "statement": "删除前端死代码：AssetListView.vue、StructuredListView.vue 与 data-migration.ts 中仅被它们使用的通用资产 API/辅助/类型。",
        "acceptance": [
          "npm --prefix web run build 通过",
          "web/src 无对已删组件与 API 函数的引用"
        ],
        "priority": "must",
        "source": "前端引用扫描：两组件无页面引用",
        "counterexample": [
          "存在页面仍 import 被删组件"
        ]
      },
      {
        "id": "R5",
        "statement": "同步测试与治理断言：DataMigrationModuleRegistrationTest 对已删源码的读取改为 Files.notExists 断言；ContentFileAssetDocCodeGovernanceTest 改为通用链路下线治理断言；ReportServiceTest/TopicServiceTest 构造调用同步。",
        "acceptance": [
          "相关测试全部通过且不再读取已删文件",
          "Files.notExists 断言覆盖 4 个已删后端文件"
        ],
        "priority": "must",
        "source": "REQ-068 收尾遗留的测试耦合",
        "counterexample": [
          "测试仍 Files.readString 已删文件"
        ]
      },
      {
        "id": "R6",
        "statement": "保留平台附件能力与 ContentAssetTables 看板/组件计数（含 dm_dependency 映射），删除链路不得影响看板计数、项目组件计数与附件访问策略。",
        "acceptance": [
          "DashboardMetricMySqlTest、ContentAssetMigrationMySqlTest 等计数测试通过",
          "ContentAssetTables.java 内容不变"
        ],
        "priority": "must",
        "source": "现场核验：ALL_TABLES/typeFor 供 DashboardService/ProjectComponentService/附件访问策略使用",
        "counterexample": [
          "删除了在用计数映射导致看板回归"
        ]
      }
    ],
    "invariants": [
      "ContentAssetTables 及其计数 UNION SQL 保持不变",
      "平台附件能力（ContentAttachmentService/AttachmentStreamService/AttachmentGateway/DataMigrationAssetAttachmentAccessPolicy）保持不变",
      "全部专属 Service/Controller/RecycleBinSource 保持不变",
      "无 Flyway 迁移、无权限/菜单/路由变更",
      "只修改 REQ-20260911-070 writable_paths；不覆盖并行 REQ-067/069 未提交改动"
    ],
    "constraints": [
      "保持 com.ccb.* 包名与现有路由语义",
      "删除后必须全仓引用扫描零残留",
      "测试必须真实运行，不以文本断言替代运行证据"
    ],
    "non_goals": [
      "不删除平台附件能力",
      "不修改 ContentAssetTables",
      "不改动专属服务与业务页面",
      "不进行数据库变更",
      "不重构看板/组件计数实现"
    ],
    "selected_approach": {
      "name": "方案 A：一次性删除 + Files.notExists 断言收敛",
      "reason": "目标代码全部为已核验的死代码，一次性删除并以文件不存在断言锁定，防止未来静默复活通用链路；平台附件与计数能力独立保留。",
      "alternatives": [
        {
          "name": "保留空壳并仅加注释",
          "rejected_because": "仍留下死代码与过期契约，不符合『彻底下线』"
        },
        {
          "name": "删除但移除全部治理断言",
          "rejected_because": "丢失防回归护栏"
        }
      ]
    },
    "architecture": {
      "delete_layer": [
        "StructuredAssetService",
        "StructuredAssetController",
        "ExcelService",
        "ContentAssetController",
        "AssetListView",
        "StructuredListView",
        "通用 API/辅助/DataMigrationAsset"
      ],
      "slim_retain": [
        "ContentFileAssetService 收敛为 resolveAttachment/replaceMainFile/BUSINESS_TYPE",
        "ContentDocCodeGenerator 收敛 6 前缀",
        "ContentRecycleBinService 注释修正"
      ],
      "retained": [
        "ContentAssetTables（看板/组件计数）",
        "平台附件链（ContentAttachmentService/AttachmentStreamService/AttachmentGateway/DataMigrationAssetAttachmentAccessPolicy）",
        "全部专属 Service/Controller/RecycleBinSource"
      ]
    },
    "error_handling": [
      "已删除端点由专属 Controller 承接，不存在新错误面",
      "若未来再次出现通用端点，Files.notExists 治理断言将失败"
    ],
    "quality_attributes": {
      "maintainability": "死代码清零，契约面收敛",
      "verifiability": "引用扫描+全量测试+构建+Files.notExists 断言",
      "regression_safety": "计数与附件测试保持，ContentAssetTables 不动"
    },
    "verification_strategy": [
      "全仓 rg 引用扫描（java/vue/ts）",
      "mvn -pl :ccb-data-migration -am test",
      "npm --prefix web run build",
      "git diff --check",
      "启动后端冒烟：依赖页列表/回收站/看板接口可用"
    ],
    "assumptions": [
      "ContentAssetTables 的 DEPENDENCY 映射在看板计数中仍被使用（已有 DashboardService/ProjectComponentService 调用证据）",
      "平台附件链为平台公共能力，本期不动（REQ-070 范围外）"
    ],
    "unknowns": [
      {
        "summary": "无阻塞未知项：删除面已全仓核验",
        "blocking": false
      }
    ],
    "decisions": [
      {
        "id": "D1",
        "decision": "删除 StructuredAssetService/StructuredAssetController/ExcelService/ContentAssetController",
        "reason": "四类均无可达调用方（TYPES/MANAGED_TYPES 空集，控制器端点不可达）"
      },
      {
        "id": "D2",
        "decision": "保留 ContentAssetTables 不动",
        "reason": "ALL_TABLES/typeFor 仍被 DashboardService、ProjectComponentService、DataMigrationAssetAttachmentAccessPolicy 使用"
      },
      {
        "id": "D3",
        "decision": "测试以 Files.notExists 锁定删除面",
        "reason": "防未来静默复活通用链路，同时避免读取已删文件"
      },
      {
        "id": "D4",
        "decision": "不删除平台附件能力与专属服务",
        "reason": "仍被在用页面与业务使用，属非目标"
      }
    ],
    "risks": [
      {
        "risk": "并行 REQ-067/069 未提交改动引用删除类",
        "mitigation": "事前已核验引用为零；删除后再次全仓扫描"
      },
      {
        "risk": "删除后看板/组件计数回归",
