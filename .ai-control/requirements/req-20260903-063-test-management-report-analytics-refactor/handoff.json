    "objective": "交付中文化、统一口径、可版本化的测试报告和分析统计能力，并以足量虚构本地数据验证。",
    "users": ["测试经理", "测试负责人", "已授权测试成员"],
    "requirements": [
      {"id":"R1","statement":"入口固定测试大类并实施服务端隔离。","acceptance":["不能跨测试大类查询"],"priority":"must","source":"用户确认","counterexample":["页面可切换其他测试大类"]},
      {"id":"R2","statement":"交付六种八章节报告组合和版本化导出。","acceptance":["项目、机构、系统均支持全周期和轮次"],"priority":"must","source":"V1.1 与用户确认","counterexample":["新建周期级或专项级报告"]},
      {"id":"R3","statement":"统一有效案例和执行中指标口径。","acceptance":["执行中不计入已执行"],"priority":"must","source":"V1.1 与用户确认","counterexample":["执行中增加已执行数"]},
      {"id":"R4","statement":"交付 26 张固定报表和 16 张固定图表。","acceptance":["RPT-001~026、CHT-001~016 可访问"],"priority":"must","source":"V1.1 与用户确认","counterexample":["仅保留 V1 四项预置"]},
      {"id":"R5","statement":"支持受约束自定义分析、共享、下钻、快照和导出。","acceptance":["组合和数据范围均受服务端限制"],"priority":"must","source":"V1.1","counterexample":["任意 SQL 或任意字段访问"]},
      {"id":"R6","statement":"提供可启停的项目加测试大类质量阈值。","acceptance":["停用指标不显示且不参与判定"],"priority":"must","source":"用户确认","counterexample":["停用指标影响质量结论"]},
      {"id":"R7","statement":"保留 V1 历史可读可导出且使用追加迁移。","acceptance":["不修改 V142~V146"],"priority":"must","source":"项目治理","counterexample":["删除历史数据或修改发布迁移"]},
      {"id":"R8","statement":"提供全状态、中文化和移动端可用体验。","acceptance":["桌面和三种手机视口无页面级横向溢出"],"priority":"must","source":"项目规约","counterexample":["仅桌面可用或英文混杂"]},
      {"id":"R9","statement":"提供本地专用、幂等且足量的虚构统计测试数据。","acceptance":["至少覆盖 3 系统、2 机构、3 轮次、6 周期、60 案例；主数据不足时零写入失败"],"priority":"must","source":"用户确认","counterexample":["Flyway 写入模拟数据或脚本写架构主数据"]}
    ],
    "invariants":["机构按责任团队组织归集","测试大类由入口固定","服务端授权不可由前端替代","报告版本快照不可变","用户可见文本为中文","模拟数据仅写测试管理自有表"],
    "constraints":["Java 17","Spring Boot 3.4.4","Vue 3","MySQL 8.4","Flyway 仅追加","仅修改任务范围路径","不新增依赖"],
    "non_goals":["变更项目、组织、物理子系统主数据所有权","跨测试大类聚合","删除历史 V1 数据"],
