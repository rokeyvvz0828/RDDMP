    "error_handling":[{"condition":"未选项目或无数据","behavior":"中文空态且不伪造零值","recovery":"选择项目或调整筛选"},{"condition":"无权限或越范围","behavior":"服务端拒绝","recovery":"切换有权限范围"},{"condition":"模拟主数据不足","behavior":"脚本零写入失败","recovery":"补齐隔离本地主数据"}],
    "quality_attributes":{"security":["认证、RBAC、租户、项目和实体范围校验","写入和导出审计"],"performance":["分页、下钻上限和预置聚合查询"],"compatibility":["V1 历史读取/导出","V147 追加"],"operations":["Flyway、实际导出文件和模拟数据分布验证"]},
    "verification_strategy":[{"requirement_ids":["R1","R3","R6"],"signal":"服务端聚合、阈值和权限","method":"模块测试/API 探测"},{"requirement_ids":["R2","R4","R5","R8"],"signal":"目录、版本、钻取、导出和视口","method":"前端构建和真实浏览器"},{"requirement_ids":["R7"],"signal":"迁移和历史兼容","method":"Flyway、范围检查和回归"},{"requirement_ids":["R9"],"signal":"模拟数据覆盖和幂等性","method":"隔离本地库执行两次并查询分布"}],
