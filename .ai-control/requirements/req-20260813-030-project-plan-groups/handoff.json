    "objective": "项目计划页可持久化维护项目级分组，主计划移动时全部后代计划保持同组。",
    "users": ["项目负责人维护项目计划分组"],
    "requirements": [
      {"id":"R1","statement":"分组属于项目且可新建、重命名和删除，删除只将计划移入未分组。","acceptance":["分组CRUD成功且刷新保持","删除分组后计划仍存在并显示在未分组"],"priority":"must","source":"用户确认的设计","counterexample":["删除分组导致计划被删除"]},
      {"id":"R2","statement":"主计划移动到分组时主计划和全部后代计划的分组归属在一个事务内同步更新。","acceptance":["多层子计划移动后group_id全部一致","刷新后关系不丢失"],"priority":"must","source":"用户确认的设计","counterexample":["子计划留在旧分组"]},
      {"id":"R3","statement":"计划页面呈现分组、主计划、子计划三级层级，已有计划默认未分组。","acceptance":["分组和计划节点可区分","存量计划显示于未分组"],"priority":"must","source":"用户确认的设计","counterexample":["分组被伪装成计划父节点"]},
      {"id":"R4","statement":"桌面端可拖动主计划进行分组，移动端提供移动到分组操作，并显示中文提示。","acceptance":["页面出现可以拖动主计划进行分组","桌面拖拽和移动端菜单均调用移动接口"],"priority":"must","source":"用户确认","counterexample":["只更新前端状态"]},
      {"id":"R5","statement":"服务端校验租户、项目访问、计划修改权限和主计划归属。","acceptance":["跨项目、子计划和无权请求被拒绝"],"priority":"must","source":"工程约束","counterexample":["构造请求可移动其他项目计划"]}
    ],
    "invariants":["parent_id层级和计划编号保持不变","tenant_id边界保持","Flyway只追加V40","前端不替代后端授权"],
