    "objective": "为迁移参数增加必填且不区分大小写唯一的参数英文名，并贯通查询、维护、Excel 与回收站。",
    "users": ["迁移参数维护人员", "Excel 批量维护人员", "参数查询与回收站管理人员"],
    "requirements": [
      {"id":"R1","statement":"参数英文名必填、最大 255 字符且只允许字母、数字和下划线。","acceptance":["新增、编辑和 Excel 导入拒绝空值、超长值和不匹配 [A-Za-z0-9_]+ 的值"],"priority":"must","source":"2026-09-09 用户确认","counterexample":["仅前端校验"]},
      {"id":"R2","statement":"参数英文名在租户、项目和系统编号范围内不区分大小写唯一。","acceptance":["同范围 ABC_01 与 abc_01 冲突","不同项目或系统可复用"],"priority":"must","source":"2026-09-09 用户确认","counterexample":["同范围大小写变体同时保存"]},
      {"id":"R3","statement":"参数英文名贯通 REST、列表、详情、表单和回收站。","acceptance":["请求 parameterNameEn，响应 parameter_name_en","页面和回收站可观察"],"priority":"must","source":"用户确认设计","counterexample":["仅落库不返回"]},
      {"id":"R4","statement":"Excel 模板、逐行导入和条件导出包含参数英文名。","acceptance":["六列模板","逐行校验","导出包含英文名"],"priority":"must","source":"用户确认设计","counterexample":["旧五列可写入缺字段记录"]},
      {"id":"R5","statement":"关键字同时匹配参数名称、参数英文名和参数说明。","acceptance":["活动列表和回收站可按英文名片段检索"],"priority":"must","source":"2026-09-09 用户确认","counterexample":["英文名不可搜索"]},
      {"id":"R6","statement":"追加 V198 建立非空列与唯一约束，不处理已有参数数据。","acceptance":["V197 不变","空表成功","有记录时失败且不回填"],"priority":"must","source":"用户确认与 Flyway 规则","counterexample":["修改 V197 或自动回填"]},
      {"id":"R7","statement":"保持项目范围、RBAC、Owner、审计、逻辑删除和响应式语义。","acceptance":["不新增权限码","保留 PARAMETER 审计","四视口无页面级溢出"],"priority":"must","source":"REQ-20260906-067 与治理规则","counterexample":["前端显隐替代服务端权限"]}
    ],
    "invariants": ["data-migration 拥有 dm_parameter", "中文参数名规则不变", "菜单路由权限不变", "V197 不修改", "不访问生产"],
    "constraints": ["Java 17/Spring Boot 3.4.4/MySQL 8.4/Vue 3", "只写 writable_paths", "复用现有 UI 与项目范围", "ASCII 值大小写不敏感唯一"],
    "non_goals": ["不处理已有数据", "不改系统参数管理", "不新增权限或公共组件", "不改变其他内容类型"],
    "selected_approach": {"name":"独立英文名列与大小写不敏感唯一索引","reason":"保留展示大小写并由数据库兜住并发。","alternatives":[{"name":"生成小写辅助列","rejected_because":"增加无必要复杂度。"},{"name":"统一转大写存储","rejected_because":"改变用户输入展示。"}]},
    "architecture": {
