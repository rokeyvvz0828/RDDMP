      "interfaces":[{"name":"Parameter REST","producer":"ccb-data-migration","consumers":["ParametersPage"],"contract":"parameterNameEn 必填，parameter_name_en 响应，400/409 错误。"},{"name":"Parameter Excel","producer":"ccb-data-migration","consumers":["Excel 用户"],"contract":"六列导入与含英文名导出。"},{"name":"Parameter keyword","producer":"ccb-data-migration","consumers":["列表","回收站"],"contract":"中文名、英文名、说明三字段匹配。"}],
