    "objective": "在四个测试大类中交付可追溯的执行与缺陷闭环。",
    "users": ["测试人员、测试经理、测试管理、机构负责人、开发人员"],
    "requirements": [
      {"id":"R1","statement":"四大类提供独立执行菜单和只读轮次周期执行树。","acceptance":["菜单、路由和只读树可达"],"priority":"must","source":"用户确认的模块6","counterexample":["执行页可新增轮次或周期"]},
      {"id":"R2","statement":"执行支持三种预览导入并拒绝无效或同目录重复案例。","acceptance":["预览与确认导入行为可测"],"priority":"must","source":"用户确认的模块6.2","counterexample":["预览直接写入或导入无效案例"]},
      {"id":"R3","statement":"执行记录实时引用案例，支持结果、附件、轨迹、筛选和导出。","acceptance":["保存后执行人、时间和轨迹更新"],"priority":"must","source":"用户确认的模块6.1/6.3","counterexample":["无效或阻塞状态无需备注"]},
      {"id":"R4","statement":"失败必须关联缺陷，批量、移动和移除按关联规则执行。","acceptance":["失败无缺陷被拒绝，未解决关联阻断移除"],"priority":"must","source":"用户确认的模块6","counterexample":["移除记录级联删除缺陷"]},
      {"id":"R5","statement":"缺陷提供新建、筛选、导出、详情和编号恒定行为。","acceptance":["BUG编号生成后系统变更仍恒定"],"priority":"must","source":"用户确认的模块7.1/7.3","counterexample":["列表默认包含已解决缺陷"]},
      {"id":"R6","statement":"缺陷状态机和执行关联快照在服务端按角色控制。","acceptance":["无权流转拒绝，解除关系转快照"],"priority":"must","source":"用户确认的模块7.2","counterexample":["快照仍可跳转已移除执行记录"]},
      {"id":"R7","statement":"写入具备隔离、RBAC、审计、删除保护和恢复。","acceptance":["跨边界请求和受保护删除被拒绝"],"priority":"must","source":"用户确认及项目规则","counterexample":["仅以前端隐藏保护写操作"]},
      {"id":"R8","statement":"前端复用全局项目、紧凑树和通用表格，并使用居中弹窗。","acceptance":["无第二项目选择器、无抽屉、移动无横向页面滚动"],"priority":"must","source":"用户确认及既有模块风格","counterexample":["新增独立项目下拉或抽屉"]}
    ],
    "invariants": ["缺陷与执行记录为平级1:N关联", "缺陷编号恒定", "不修改公共UI和平台附件", "V127只追加"],
    "constraints": ["仅当前任务授权路径", "Java17/Spring Boot/Vue3/Element Plus", "全局项目上下文", "全部弹窗居中"],
