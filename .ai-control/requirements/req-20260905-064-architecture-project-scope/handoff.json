    "human_document": "docs/engineering-control/designs/2026-09-05-architecture-project-scope-design.md",
    "objective": "六类架构与环境业务数据及相关审批在顶部当前项目下实现服务端强制隔离，不同项目可复用业务编号且不会发生跨项目读取、写入或关联。",
    "users": ["项目成员", "架构维护人员", "项目审批人", "超级管理员"],
    "requirements": [
      {"id":"R1","statement":"六类主数据及关键子数据显式保存项目归属。","acceptance":["查询和写入限定 tenant_id 与 project_id","直接 ID 不跨项目"],"priority":"must","source":"批准设计","counterexample":["仅按 tenant_id 查询"]},
      {"id":"R2","statement":"页面跟随顶部项目并保留架构管理菜单。","acceptance":["无第二项目选择器","切换后只显示当前项目"],"priority":"must","source":"批准设计","counterexample":["显示租户全量数据"]},
      {"id":"R3","statement":"编号和名称项目内永久唯一。","acceptance":["跨项目可重复","同项目软删除后不可复用"],"priority":"must","source":"批准设计","counterexample":["租户级唯一"]},
      {"id":"R4","statement":"关联、下发、实例和计划目标保持项目一致。","acceptance":["跨项目候选不可见","伪造 ID 被拒绝"],"priority":"must","source":"批准设计","counterexample":["项目 A 引用项目 B"]},
      {"id":"R5","statement":"项目成员资格与 architecture RBAC 叠加授权。","acceptance":["非成员 403","缺权限 403","超级管理员明确项目访问"],"priority":"must","source":"批准设计","counterexample":["只依赖前端显隐"]},
      {"id":"R6","statement":"搭建计划模板租户共享，执行计划按项目隔离。","acceptance":["模板无 project_id","生成计划有当前 project_id"],"priority":"must","source":"批准设计","counterexample":["模板项目私有"]},
      {"id":"R7","statement":"复用项目工作流并传递真实项目上下文。","acceptance":["业务与 wf_instance 项目一致","回调项目不一致不更新"],"priority":"must","source":"批准设计","counterexample":["WorkflowBusinessContext 项目为空"]},
      {"id":"R8","statement":"存量数据归入 RDDMP-PLATFORM，缺失时失败。","acceptance":["迁移后无空项目","默认项目缺失迁移失败"],"priority":"must","source":"批准设计","counterexample":["自动选择其他项目"]},
      {"id":"R9","statement":"存在架构数据的项目禁止删除。","acceptance":["有引用返回 409","无引用保持原行为"],"priority":"must","source":"批准设计","counterexample":["删除后遗留孤立数据"]},
      {"id":"R10","statement":"数据迁移和测试管理按项目匹配物理子系统。","acceptance":["重复编号不串项目","受影响模块回归通过"],"priority":"must","source":"工程勘察","counterexample":["JOIN 缺少 project_id"]},
      {"id":"R11","statement":"具体环境用户界面改名环境管理，稳定技术契约不变。","acceptance":["用户文案为环境管理","包名表名 API 不重命名"],"priority":"must","source":"用户请求","counterexample":["迁移数据库表名"]}
    ],
    "invariants": ["tenant_id 与 project_id 来自可信上下文", "业务 DTO 不接收项目主键", "architecture 不直写其他模块表", "system 不反向依赖 architecture", "模板保持租户共享", "历史 Flyway 与 ACT_* 不修改"],
    "constraints": ["Java 17", "Spring Boot 3.4.4", "MySQL 8.4", "Vue 3", "复用 ProjectAccessService 与 WorkflowBusinessGateway", "前端遵循 design-h5.md", "只使用本地测试数据"],
    "non_goals": ["跨项目共享或转移", "新增项目级角色", "页面移入项目详情", "重新实现工作流项目权限", "重命名稳定技术契约"],
    "selected_approach": {"name":"全链路显式项目归属","reason":"数据库约束和直接 ID 隔离可明确验证。","alternatives":[{"name":"根实体推导","rejected_because":"子数据直接访问易漏隔离。"},{"name":"项目绑定表","rejected_because":"与单项目独占不一致。"}]},
    "architecture": {
      "boundary": {"inside":["business/architecture","platform/system 删除扩展","架构前端","Flyway 与 Mock","受影响消费者"],"outside":["Flowable ACT_*","工作流项目权限内部实现","生产数据"]},
      "components": [
        {"name":"前端项目上下文","responsibility":"提供当前 projectRef","depends_on":["useProjectContextStore"]},
        {"name":"项目上下文解析","responsibility":"解析可信 ProjectAccess","depends_on":["ProjectAccessService"]},
        {"name":"架构 Service/Store","responsibility":"项目一致性和 tenant_id + project_id 持久化","depends_on":["项目上下文解析"]},
        {"name":"项目删除 guard","responsibility":"删除前检查架构引用","depends_on":["system 扩展点"]},
        {"name":"工作流接入","responsibility":"传递并校验项目上下文","depends_on":["WorkflowBusinessGateway"]},
        {"name":"消费者适配","responsibility":"按项目关联物理子系统","depends_on":["arch_physical_subsystem.project_id"]}
      ],
      "interfaces": [
        {"name":"ProjectAccessService","producer":"platform/system","consumers":["business/architecture"],"contract":"按 projectRef 返回可信项目"},
        {"name":"ProjectDeletionGuard","producer":"platform/system","consumers":["business/architecture"],"contract":"项目删除前业务引用检查"},
        {"name":"WorkflowBusinessGateway","producer":"platform/workflow","consumers":["business/architecture"],"contract":"项目业务上下文固化实例项目"}
      ],
      "data_flows": [
        {"input":"projectRef 与认证用户","transitions":["访问校验","解析 projectId","项目限定读写"],"output":"当前项目数据或错误"},
        {"input":"项目业务提交","transitions":["业务项目校验","工作流启动","回调复核"],"output":"项目隔离审批"},
        {"input":"历史架构数据","transitions":["默认项目查找","回填","约束校验"],"output":"非空项目归属"}
      ]
    },
    "error_handling": [
      {"condition":"projectRef 缺失","behavior":"400","recovery":"选择项目后重试"},
      {"condition":"无项目访问或动作权限","behavior":"403","recovery":"申请权限"},
      {"condition":"实体不属于项目","behavior":"404","recovery":"返回当前项目列表"},
      {"condition":"跨项目关联","behavior":"400","recovery":"选择当前项目对象"},
      {"condition":"工作流项目不一致","behavior":"拒绝且不改变业务","recovery":"修正上下文"},
      {"condition":"默认项目缺失","behavior":"迁移失败","recovery":"创建唯一活动默认项目"},
      {"condition":"项目有架构引用","behavior":"409","recovery":"先处理架构数据"}
    ],
    "quality_attributes": {"security":["认证、RBAC、成员和实体归属校验"],"performance":["tenant_id + project_id 前缀索引"],"compatibility":["稳定包名表名 API"],"operations":["迁移前后完整性检查"]},
    "verification_strategy": [
      {"requirement_ids":["R1","R2","R4","R5"],"signal":"双项目 API 与浏览器无泄漏","method":"成员与超级管理员正负矩阵"},
      {"requirement_ids":["R3","R8"],"signal":"唯一性和迁移规则稳定","method":"真实 MySQL"},
      {"requirement_ids":["R6","R7"],"signal":"模板共享且流程项目一致","method":"集成测试"},
      {"requirement_ids":["R9","R10","R11"],"signal":"删除保护、消费者和文案通过","method":"模块回归和浏览器验收"}
    ],
    "assumptions": [{"text":"有存量架构数据的租户存在唯一活动 RDDMP-PLATFORM","basis":"用户确认","falsifier":"迁移查询为零或多条"},{"text":"消费者能从自身记录或父链取得项目 ID","basis":"工程勘察","falsifier":"T7 审计发现无可靠项目键"}],
    "unknowns": [{"question":"执行时下一个 Flyway 版本","impact":"决定迁移文件名","owner":"实施协调者","blocking":false}],
    "decisions": [{"id":"D1","decision":"单项目独占","reason":"完全隔离","source":"用户批准"},{"id":"D2","decision":"默认项目迁移","reason":"归属确定","source":"用户批准"},{"id":"D3","decision":"模板共享","reason":"模板是租户复用结构","source":"用户批准"},{"id":"D4","decision":"保留架构菜单","reason":"沿用专业工作区","source":"用户批准"},{"id":"D5","decision":"项目内永久唯一","reason":"项目独立维护编号","source":"用户批准"},{"id":"D6","decision":"成员与 RBAC 叠加","reason":"复用权限","source":"用户批准"},{"id":"D7","decision":"全链路 project_id","reason":"隔离可验证","source":"用户批准"},{"id":"D8","decision":"复用项目工作流","reason":"平台已项目化","source":"用户批准"}],
    "risks": [{"risk":"多表迁移错误","impact":"迁移失败或空项目","mitigation":"分阶段 SQL 和 MySQL 测试"},{"risk":"遗漏项目条件","impact":"越权","mitigation":"双项目负向测试和 SQL 扫描"},{"risk":"公共删除扩展点","impact":"system 回归","mitigation":"Owner 复核和聚焦测试"},{"risk":"跨模块旧 JOIN","impact":"重复编号串数据","mitigation":"固定消费者清单和回归"}],
