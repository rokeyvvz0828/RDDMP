          ".ai-control/requirements/req-20260907-070-project-creation-type"
        ],
        "outside": [
          "其他业务模块",
          "公共UiStatusTag实现",
          "已发布迁移",
          "生产库与.env"
        ]
      },
      "components": [
        {
          "name": "ProjectService/pm_project",
          "responsibility": "类型校验、持久化、列表详情返回和原审计",
          "depends_on": [
            "原项目权限及JdbcTemplate"
          ]
        },
        {
          "name": "ProjectView",
          "responsibility": "创建/编辑字段与保存成功同步元数据",
          "depends_on": [
            "原project API",
            "project-context store",
            "Element Plus"
          ]
        },
        {
          "name": "project-context/AppLayout",
          "responsibility": "携带类型并呈现三个入口标签",
          "depends_on": [
            "workbench response",
            "UiStatusTag"
          ]
        }
      ],
      "interfaces": [
        {
          "name": "creation_type",
          "producer": "project API",
          "consumers": [
            "ProjectView",
            "project-context"
          ],
          "contract": "NEW/CONTINUATION；创建缺失默认NEW，更新缺失保留；显式空或非法值400；列表详情包含字段"
        }
      ],
      "data_flows": [
        {
          "input": "创建/编辑保存",
          "transitions": [
            "前端枚举选择",
            "原服务端授权及类型校验",
            "事务写入与原审计",
            "响应更新业务页和顶部项目元数据"
          ],
          "output": "类型持久化且标签立即一致"
        },
        {
          "input": "切换项目",
          "transitions": [
            "读取现有项目选项及类型",
            "沿用原确认与select"
          ],
          "output": "新项目标签和内容一致"
        }
      ]
    },
    "error_handling": [
      {
        "condition": "保存失败/非法类型",
        "behavior": "保留表单和顶部原值，显示原错误反馈及字段校验",
        "recovery": "修改后重试"
      },
      {
        "condition": "顶部加载失败/空列表",
        "behavior": "沿用加载、空及重试，不伪造项目",
        "recovery": "原retry"
      },
      {
        "condition": "旧响应缺少新增字段",
        "behavior": "仅缺失值兼容NEW；不把非法类型静默解释为续建",
        "recovery": "后端升级和刷新"
      }
    ],
    "quality_attributes": {
