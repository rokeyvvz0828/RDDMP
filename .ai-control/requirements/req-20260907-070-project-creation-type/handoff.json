    "design_revision": 1,
    "design_status": "approved",
    "human_document": "docs/engineering-control/designs/2026-09-07-project-creation-type-design.md",
    "objective": "持久化项目创建类型并在顶部项目切换所有入口一致展示",
    "users": [
      "项目管理员维护类型",
      "项目成员切换项目前识别类型"
    ],
    "requirements": [
      {
        "id": "R1",
        "statement": "新建和编辑项目可维护创建类型，仅新建/续建",
        "acceptance": [
          "新建默认NEW，选择CONTINUATION后保存、详情读取、编辑回显一致",
          "显式空值或非法值由服务端拒绝且不写库"
        ],
        "priority": "must",
        "source": "用户请求及确认",
        "counterexample": [
          "仅前端显示，刷新丢失"
        ]
      },
      {
        "id": "R2",
        "statement": "已有项目统一新建，之后可编辑为续建",
        "acceptance": [
          "追加迁移使存量项目creation_type为NEW",
          "旧客户端创建不传时默认NEW；更新不传时保留原值"
        ],
        "priority": "must",
        "source": "用户确认已有项目默认规则",
        "counterexample": [
          "编辑无关字段将续建覆盖为新建"
        ]
      },
      {
        "id": "R3",
        "statement": "顶部当前项目及下拉选项展示创建类型，保存后同步",
        "acceptance": [
          "桌面侧栏/顶栏及移动三个选择入口均显示名称和类型标签",
          "保存成功后当前项目标签同步；不改变选中项目、不触发切换确认或页面重载",
          "刷新后保持正确标签"
        ],
        "priority": "must",
        "source": "用户请求与已确认提案",
        "counterexample": [
          "只显示下拉选项，收起时无类型",
          "需退出登录才刷新类型"
        ]
      },
      {
        "id": "R4",
        "statement": "保持原权限、审计、切换与响应式可用性",
        "acceptance": [
          "读写继续认证、RBAC、租户/实体权限与原审计",
          "四种规定视口及明暗主题下标签可见、长名称不遮挡，表单提交/取消可达",
          "加载、空、失败、无权限、提交中及取消切换行为保持"
        ],
        "priority": "must",
        "source": "仓库规约及功能不变量",
        "counterexample": [
          "为显示标签更改项目选择值或绕过权限"
        ]
      }
    ],
    "invariants": [
      "保留现有项目权限/数据范围/审计",
      "不改变项目切换确认和选中引用",
      "不覆盖其他未提交改动"
    ],
    "constraints": [
      "只追加Flyway迁移；不直接修改现有库",
      "涉及platform/system、迁移及应用壳的写入须经范围和Owner批准",
      "不读取.env，不重启服务，不提交推送",
      "设计批准后先编写实施计划，实施须通过计划批准及控制门禁"
    ],
    "non_goals": [
      "类型字典维护",
      "续建关联原项目或复制数据",
      "按类型驱动计划/投产规则",
      "项目列表改版、筛选和统计"
    ],
    "selected_approach": {
      "name": "项目独立枚举字段",
      "reason": "两种固定语义，已有Map API与SQL可增量扩展；刷新和跨页有一致数据源",
      "alternatives": [
        {
          "name": "通用配置字典",
          "rejected_because": "用户未要求可配置类型，增加无关维护入口和状态"
        },
        {
          "name": "前端会话标记",
          "rejected_because": "不能满足跨会话持久化和统一读取"
        }
      ]
    },
    "architecture": {
      "boundary": {
        "inside": [
          "server/src/platform/system/src/main/java/com/ccb/system/project/ProjectService.java",
          "server/src/platform/system/src/test/java/com/ccb/system/project/ProjectServiceTest.java",
