    "objective": "Build a reusable single-tenant frontend foundation and continue system, workflow, and AI modules without duplicating visual or integration contracts.",
    "users": ["platform administrators", "workflow operators", "module integrators"],
    "requirements": [
      {"id":"R9","statement":"Theme presets change the complete visual system and persist.","acceptance":["four palettes","light dark system appearance","refresh persistence"],"priority":"must","source":"user-approved design","counterexample":["only one dark toggle"]},
      {"id":"R10","statement":"Side, top, and mixed navigation layouts are selectable and persist.","acceptance":["same menu tree","active route preserved","no desktop overflow"],"priority":"must","source":"user-approved design","counterexample":["fixed aside only"]},
      {"id":"R11","statement":"Typed shared UI components provide consistent page, table, form, status, and empty-state presentation.","acceptance":["component contracts","used by two business pages"],"priority":"must","source":"user-approved design","counterexample":["page-local duplicated styles"]},
      {"id":"R12","statement":"Dynamic menu rendering is recursive and independent of root ordering.","acceptance":["arbitrary depth","allowlisted component paths"],"priority":"must","source":"user-approved design","counterexample":["auth.routes[0] assumption"]},
      {"id":"R13","statement":"System administration modules provide authenticated CRUD flows.","acceptance":["users roles orgs menus dicts configs","response contract","permission enforcement"],"priority":"must","source":"user-approved design","counterexample":["placeholder pages"]},
      {"id":"R14","statement":"Workflow definitions and approval runtime have explicit versioned contracts.","acceptance":["definitions","tasks","inbox","approve reject"],"priority":"must","source":"user-approved design","counterexample":["unversioned JSON executor"]},
      {"id":"R15","statement":"AI models and future module capabilities use a server-side audited integration contract.","acceptance":["secret redaction","routing","capability validation","execution audit"],"priority":"must","source":"user-approved design","counterexample":["browser-side provider secret"]}
    ],
    "invariants":["single tenant","tenant_id retained","backend authorization","auth behavior unchanged","secrets server-side","allowlisted component paths"],
    "constraints":["Vue 3","TypeScript","Vite","Element Plus","Pinia","Vue Router","Spring Boot 3.x","JDK 17","MyBatis-Plus","MySQL 8","Flyway"],
    "non_goals":["multi-tenant isolation in this slice","microservices","browser-side AI credentials","unbounded dynamic code loading"],
    "selected_approach":{"name":"CSS token presets plus one preference store","reason":"Centralized visual tokens keep themes and layouts consistent while preserving independent route and auth behavior.","alternatives":["Element Plus ConfigProvider only","separate shells per theme and layout"]},
    "architecture":{"boundary":{"inside":["frontend shell","backend modules","migrations","tests"],"outside":["browser runtime","MySQL service","future provider services"]},"components":["ui preference store","layout shell","shared UI primitives","system module","workflow module","AI module"],"interfaces":["REST response","dynamic route tree","UI props/events","workflow transition","AI capability contract"],"data_flows":["backend route tree -> allowlisted frontend renderer","preference store -> document data attributes -> semantic CSS tokens","domain command -> service -> mapper -> audit"]},
    "error_handling":["401 redirects to login","403 shows permission state","validation returns field errors","AI secrets are redacted","invalid workflow transitions are rejected idempotently"],
    "quality_attributes":{"security":["server-side authorization","secret redaction"],"performance":["lazy pages","bounded lists"],"compatibility":["desktop and tablet layouts"],"operations":["audit rows","repeatable migrations"]},
    "verification_strategy":["Maven tests","frontend build","browser flow","DOM attribute checks","database assertions","redaction checks"],
    "assumptions":[{"text":"local Java, Maven, Node, MySQL, and browser are available","basis":"existing project baseline","falsifier":"health or build check fails"}],
    "unknowns":[{"question":"which external AI providers will be enabled in production","impact":"adapter implementation only","blocking":false}],
    "decisions":[{"id":"D9","decision":"separate appearance, palette, layout, sidebar, and density state","reason":"prevents a color toggle from owning layout behavior","source":"user-approved design"}],
