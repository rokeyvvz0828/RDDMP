    {
      "module": "ai",
      "name": "智能能力",
      "features": ["服务商配置", "模型管理", "能力路由", "执行审计"],
      "entry": "/ai",
      "dataStrategy": "database",
      "tables": ["ai_provider", "ai_model", "ai_route", "ai_execution"]
    },
    {
      "module": "notifications",
      "name": "系统消息",
      "features": ["未读数量", "消息列表", "标记已读", "全部已读"],
      "entry": "global shell",
      "dataStrategy": "database",
      "tables": ["sys_notification", "sys_user_notification"]
    },
    {
      "module": "file-preview",
      "name": "文件预览",
      "features": ["文件能力查询", "受控上传", "在线预览"],
      "entry": "shared component",
      "dataStrategy": "external-local-service",
      "tables": []
    },
    {
      "module": "delivery-showcase",
      "name": "交付示范中心",
      "features": ["列表检索", "标准表单", "分步表单", "详情抽屉", "流程审批", "柱状图", "饼图", "折线图", "甘特图"],
