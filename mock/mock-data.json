  "catalog": [
    {
      "module": "system",
      "name": "系统管理",
      "features": ["用户管理", "角色权限", "组织架构", "菜单路由", "参数管理"],
      "entry": "/system",
      "dataStrategy": "database",
      "tables": ["sys_org", "sys_user", "sys_role", "sys_user_role", "sys_role_menu", "sys_role_permission", "sys_dict_type", "sys_dict_item", "sys_config"]
    },
    {
      "module": "project-management",
      "name": "项目管理",
      "features": ["项目工作台", "项目计划", "项目成员", "项目角色", "项目日历", "计划统计"],
      "entry": "/projects",
      "dataStrategy": "database",
      "tables": ["pm_project", "pm_project_plan", "pm_project_role", "pm_project_member", "pm_project_member_role", "pm_project_plan_org"]
    },
    {
      "module": "workflow",
      "name": "工作流",
      "features": ["流程定义", "审批待办", "流程已办", "流程监控", "流程审计"],
      "entry": "/workflow",
      "dataStrategy": "database",
      "tables": ["wf_definition", "wf_version", "wf_instance", "wf_task", "wf_task_action", "wf_audit_event"]
    },
    {
      "module": "ai",
      "name": "智能能力",
      "features": ["服务商配置", "模型管理", "能力路由", "执行审计"],
      "entry": "/ai",
      "dataStrategy": "database",
      "tables": ["ai_provider", "ai_model", "ai_route", "ai_execution"]
    },
    {
      "module": "notifications",
      "name": "系统消息",
      "features": ["未读数量", "消息列表", "标记已读", "全部已读"],
      "entry": "global shell",
      "dataStrategy": "database",
      "tables": ["sys_notification", "sys_user_notification"]
    },
    {
      "module": "file-preview",
      "name": "文件预览",
      "features": ["文件能力查询", "受控上传", "在线预览"],
      "entry": "shared component",
      "dataStrategy": "external-local-service",
      "tables": []
    },
    {
      "module": "delivery-showcase",
      "name": "交付示范中心",
      "features": ["列表检索", "标准表单", "分步表单", "详情抽屉", "流程审批", "柱状图", "饼图", "折线图", "甘特图"],
      "entry": "/delivery-showcase",
      "dataStrategy": "frontend-session-mock",
      "source": "web/src/modules/delivery-showcase/mock.ts",
      "tables": []
    },
    {
      "module": "business-form-metadata",
      "name": "交付工单输入项配置",
      "features": ["业务范围", "表单分区", "字段定义", "条件规则", "静态选项", "发布快照"],
      "entry": "/system/form-metadata",
