  "catalog": [
    {
      "module": "system",
      "name": "系统管理",
      "features": ["用户管理", "角色权限", "组织架构", "菜单路由", "参数管理"],
      "entry": "/system",
      "dataStrategy": "database",
      "tables": ["sys_org", "sys_user", "sys_role", "sys_user_role", "sys_role_menu", "sys_role_permission", "sys_dict_type", "sys_dict_item", "sys_config"]
    },
    {
      "module": "workflow",
      "name": "工作流",
      "features": ["流程定义", "审批待办", "流程已办", "流程监控", "流程审计"],
