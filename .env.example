DB_URL=jdbc:mysql://127.0.0.1:3306/ccb_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=ccb
DB_PASSWORD=replace-with-local-db-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_ACCESS_TTL_MILLIS=900000
JWT_REFRESH_TTL_MILLIS=604800000
MYSQL_PASSWORD=replace-with-local-db-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MINIO_ACCESS_KEY=replace-with-local-minio-access-key
MINIO_SECRET_KEY=replace-with-local-minio-secret-key
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_BUCKET=ccb-platform
MINIO_PRESIGNED_EXPIRY_SECONDS=3600
FILE_PREVIEW_ENABLED=true
FILE_PREVIEW_MAX_FILE_SIZE=50MB
FILE_PREVIEW_MAX_FILE_SIZE_BYTES=52428800
FILE_PREVIEW_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,md,csv,jpg,jpeg,png,gif,bmp,webp
MOCK_DATA_ENABLED=true
MOCK_DATA_RESOURCE=classpath:mock/mock-data.json
KK_FILE_VIEW_IMAGE=keking/kkfileview:5.0.1
KK_FILE_VIEW_BASE_URL=http://127.0.0.1:8012
KK_FILE_VIEW_PORT=8012
KK_FILE_VIEW_HOST_ALIAS=minio.local
KK_FILE_VIEW_TRUST_HOST=host.docker.internal
KK_FILE_VIEW_NOT_TRUST_HOST=localhost,127.0.0.1,0.0.0.0,10.*,192.168.*,172.16.*,172.17.*,172.18.*,172.19.*,172.20.*,172.21.*,172.22.*,172.23.*,172.24.*,172.25.*,172.26.*,172.27.*,172.28.*,172.29.*,172.30.*,172.31.*
BOOTSTRAP_ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-password-hash
